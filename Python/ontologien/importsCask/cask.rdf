    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/plangeo1#are_on_line">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1630"/>
        <OM-Math-Meta:description>The statement that a set of points is collinear.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/plangeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1630">
