    <!-- http://www.openmath.org/cd/opnode#divide -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/opnode#divide">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>A constant value, constructs the divide for division nodes.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/opnode"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/opnode#minus -->

