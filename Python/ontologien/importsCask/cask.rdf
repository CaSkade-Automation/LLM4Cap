        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/physical_consts1#mole -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#mole">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the number of atoms in one gramme of carbon(12).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/physical_consts1#speed_of_light -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#speed_of_light">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1622"/>
        <OM-Math-Meta:commentedProperty>The speed of light is approximately 299792458 metres per second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the speed of light in a vacuum. It is
approximately 299792458 metres per second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1622">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#approx"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/physical_consts1#zero_Celsius -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#zero_Celsius">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the zero of the Celsius temperature scale.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/physical_consts1#zero_Fahrenheit -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#zero_Fahrenheit">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the zero of the Fahrenheit temperature scale.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/piece1#otherwise -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/piece1#otherwise">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1624"/>
        <OM-Math-Meta:description>This symbol introduces the &apos;default&apos; value of a piecewise construct.
If none of the previous piece constructs can provide the value, this will.
It has a single child, the value.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/piece1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1624">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/piece1#piece -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/piece1#piece">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1626"/>
        <OM-Math-Meta:description>This introduces an individual component of a piecewise definition. It has
precisely two arguments: the first is the value, and the second is a Boolean
(meant to be a predicate) which is true if and only if this piece is to
provide the value of the piecewise construct.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/piece1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1626">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/piece1#piecewise -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/piece1#piecewise">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1628"/>
        <OM-Math-Meta:description>This operator heads an expression that is being defined piecewise. Its 
arguments are n objects built with the piece constructor, optionally
followed by one built with otherwise constructor.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/piece1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1628">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
