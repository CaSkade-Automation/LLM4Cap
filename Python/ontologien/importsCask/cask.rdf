        <OM-Math-Meta:description>Attribution tag to denote the
    type of inductively defined natural numbers. It is also denoted as
    setname1:N.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/indnat"/>
    </owl:NamedIndividual>
    


