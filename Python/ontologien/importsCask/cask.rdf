    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/setname1#C -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname1#C">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2173"/>
        <OM-Math-Meta:commentedProperty>for all z | if z is complex then there exist reals x,y 
s.t. z = x + i * y</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This  symbol represents the set of complex numbers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
