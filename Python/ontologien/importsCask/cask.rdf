    <!-- http://www.openmath.org/cd/transc3#arccosh -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arccosh">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2399"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2401"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2403"/>
        <OM-Math-Meta:commentedProperty>Arccosh z = ln(z +-\sqrt(z^2-1))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>Arccosh(z) =  i * Arccos(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arccosh(x) &lt;=&gt; cosh(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the Arccosh function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:comment>A+S says +/- i ..., but this is irrelevant since Arccos(iz)=-Arccos(iz)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2399">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
