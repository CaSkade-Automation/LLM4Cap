        <OM-Math-Meta:formalProperty rdf:nodeID="genid1206"/>
        <OM-Math-Meta:commentedProperty>not true = false</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean value true.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1206">
