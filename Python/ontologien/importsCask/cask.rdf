    <!-- http://www.openmath.org/cd/transc3#arcsec -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arcsec">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2427"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2429"/>
        <OM-Math-Meta:commentedProperty>arcsec(z) = -i ln(1/z+i \sqrt(1-1/z^2)), so the multi-valued equivalent is
Arcsec(z) = -i Ln(1/z+i \Sqrt(1-1/z^2)), encoded as
Arcsec(z) = -i(ln(1/z+i \sqrt(1-1/z^2)) union ln(1/z-i \sqrt(1-1/z^2)))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arcsec(x) &lt;=&gt; sec(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the multivalued arcsec function as the inverse of
sec.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2427">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
