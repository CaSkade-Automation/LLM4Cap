    <!-- http://www.openmath.org/cd/transc1#arcsin -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arcsin">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2311"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2313"/>
        <OM-Math-Meta:commentedProperty>arcsin(z) = -i ln (sqrt(1-z^2)+iz)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>x in [-(pi/2),(pi/2)] implies arcsin(sin x) = x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arcsin function. This is the inverse of the
sin function as described in Abramowitz and Stegun, section 4.4. It
takes one argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2311">
