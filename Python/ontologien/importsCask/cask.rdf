    <!-- http://www.openmath.org/cd/hypergeo0 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo0">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD defines some basic hypergeometric integrals and
    symbols necessary to define hypergeometric functions.
	These functions are described in the following books.
	(1) Handbook of Mathematical Functions, Abramowitz, Stegun
	(2) Higher transcendental functions. Vol. III. Krieger Publishing Co., Inc., Melbourne, Fla., 1981, Erdlyi, Arthur; Magnus, Wilhelm; Oberhettinger, Fritz; Tricomi, Francesco G. 
	(3) From Gauss to Painleve, Vieweg, Katsunori Iwasaki, Hironobu Kimura, Shun Shimomura, Masaaki Yoshida</OM-Math-Meta:description>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/hypergeo1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD defines the Gauss hypergeometric function, confluent
    hypergeometric functions, and generalized hypergeometric functions
    in one variable.
	These functions are described in the following books.
	(1) Handbook of Mathematical Functions, Abramowitz, Stegun
	(2) Higher transcendental functions. Vol. III. Krieger Publishing Co., Inc., Melbourne, Fla., 1981, Erdlyi, Arthur; Magnus, Wilhelm; Oberhettinger, Fritz; Tricomi, Francesco G. 
	(3) From Gauss to Painleve, Vieweg, Katsunori Iwasaki, Hironobu Kimura, Shun Shimomura, Masaaki Yoshida.</OM-Math-Meta:description>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/hypergeon0 -->

