    <!-- http://www.openmath.org/cd/list3#select -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/list3#select">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1180"/>
        <OM-Math-Meta:description>This symbol takes two lists as arguments, L and M say. The second argument is a
 list containing only entries from [1..n], where n is the length of
L. The symbol represents the 
function which returns a list whose length is equal to the length of
M, and having at position k the  value of L at position M_k.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/list3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1180">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic1#and -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#and">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1182"/>
        <OM-Math-Meta:commentedProperty>for all x | x and not(x) = false</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the logical and function which is an n-ary
function taking boolean arguments and returning a boolean value. It
is true if all arguments are true or false otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1182">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid1183"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1183">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic1#equivalent -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#equivalent">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1186"/>
        <OM-Math-Meta:commentedProperty>The condition (A is equivalent to B) is equivalent to the
condition that (A implies B and B implies A)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to show that two boolean expressions are logically 
equivalent, that is have the same boolean value for any inputs.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1186">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic1#false -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#false">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1188"/>
        <OM-Math-Meta:commentedProperty>not false = true</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean value false.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1188">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
