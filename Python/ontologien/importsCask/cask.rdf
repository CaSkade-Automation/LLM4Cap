    <!-- http://www.openmath.org/cd/aggregate_cats#finiteSetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#finiteSetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid225"/>
        <OM-Math-Meta:commentedProperty>finite set type has set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of finite sets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid225">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#infiniteSetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#infiniteSetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid227"/>
        <OM-Math-Meta:commentedProperty>infinite set type does not have finite set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>infinite set type has set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of infinite sets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid227">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#multisetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#multisetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid229"/>
        <OM-Math-Meta:commentedProperty>multisetType is an aggregate type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of multisets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid229">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#non_continuousSetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#non_continuousSetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid231"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid233"/>
        <OM-Math-Meta:commentedProperty>non-continuous set type does not have continuous set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>non-continuous set type has set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of non-continuous sets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid231">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid233">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
