    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/setname2#Zm -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#Zm">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2221"/>
        <OM-Math-Meta:example rdf:nodeID="genid2223"/>
        <OM-Math-Meta:example rdf:nodeID="genid2225"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2227"/>
        <OM-Math-Meta:commentedProperty>for all x in the integers modulo m |
there exists an n such that n is an integer and n &lt;= m  and x^n = x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of integers modulo m, where m is not necessarily
a prime. It takes one argument, the integer m.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
