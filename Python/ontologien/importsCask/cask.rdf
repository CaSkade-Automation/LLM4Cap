        <OM-Math-Meta:description>The round down (to -infinity) operation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/rounding1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2006">
