    <!-- http://www.openmath.org/cd/permutation1#permutationsn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/permutation1#permutationsn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1586"/>
        <OM-Math-Meta:description>This symbol is a unary function. Its argument should
		be a positive integer. When applied to argument n,
		the resulting value is the set of all permutations of the set
                {1,..., n}.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/permutation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1586">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/permutation1#right_compose -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/permutation1#right_compose">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1588"/>
        <OM-Math-Meta:description>This symbol is a binary function. Its
		arguments should be permutations. When applied to
		arguments P1 and P2, the resulting
		value is the permutation which maps x in Support(P1)
		union Support(P2) to P2(P1(x)).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/permutation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1588">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
