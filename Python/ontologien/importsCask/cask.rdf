    </owl:DatatypeProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasVariableType -->

    <owl:DatatypeProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasVariableType">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
    </owl:DatatypeProperty>
    


