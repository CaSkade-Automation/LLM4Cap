    <!-- http://www.openmath.org/cd/3Dgeo2#normal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#normal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid83"/>
        <OM-Math-Meta:description>The symbol represents a binary boolean function with a line as first argument and a plane as second argument.
Its value is true whenever the first argument is normal to the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid83">
