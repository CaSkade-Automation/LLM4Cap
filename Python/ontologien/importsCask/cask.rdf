    <!-- http://www.openmath.org/cd/rounding1#trunc -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/rounding1#trunc">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2018"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2022"/>
        <OM-Math-Meta:commentedProperty>for all x | trunc(x) &lt;= x &lt; trunc(x)+1 (x&gt;0)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x | trunc(x) &gt;= x &gt; trunc(x)-1 (x&lt;0)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The round to zero operation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/rounding1"/>
