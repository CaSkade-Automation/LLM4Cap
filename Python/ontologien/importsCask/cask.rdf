        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc3#arcsech -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arcsech">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2431"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2433"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2435"/>
        <OM-Math-Meta:commentedProperty>Arcsech z = ln(1/z +-\sqrt(1/z^2-1))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>Arcsech(z) =  i * Arcsec(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arcsech(x) &lt;=&gt; sech(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the Arcsech function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:comment>A+S says +/- i ..., but this is irrelevant since Arcsec(iz)=-Arcsec(iz)</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2431">
