    <!-- http://www.openmath.org/cd/3Dgeo1#circle -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo1#circle">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid55"/>
        <OM-Math-Meta:description>The symbol is used to indicate a circle in 3-dimensional Euclidean geometry by
a variable. The circle may (but need not) be subject to constraints.
The symbol takes the variable as the first argument and the
constraints as further arguments.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid55">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


