    <!-- http://www.openmath.org/cd/transc1#arctan -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arctan">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2319"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2321"/>
        <OM-Math-Meta:commentedProperty>arctan(z) = (i/2)ln((1-iz)/(1+iz))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>x in (-(pi/2),(pi/2)) implies arctan(tan x) = x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arctan function. This is the inverse of the
tan function as described in Abramowitz and Stegun, section 4.4. It
takes one argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2319">
