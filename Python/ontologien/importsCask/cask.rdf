        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/fns1#left_inverse -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/fns1#left_inverse">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>This symbol is used to describe the left inverse of its argument (a
function). This inverse may only be partially defined because the
function may not have been surjective. If the function is not
surjective the left inverse function is
ill-defined without further stipulations. No other assumptions are made on
the semantics of this left inverse.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/fns1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/fns1#range -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/fns1#range">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid631"/>
        <OM-Math-Meta:commentedProperty>the range of f is a subset of the image of f</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol denotes the range of a function, that is a set that the
function will map to. The single argument should be the function whos
range is being queried. It should be noted that this is not necessarily
equal to the image, it is merely required to contain the image.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/fns1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid631">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/set1#subset"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/fns1#restriction -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/fns1#restriction">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid633"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid635"/>
        <OM-Math-Meta:description>restriction takes two arguments, a function f, and a set S, which
should be a subset of domain(f) and returns the function
f restricted to S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/fns1"/>
    </owl:NamedIndividual>
