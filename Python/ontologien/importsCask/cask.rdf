    <!-- http://www.openmath.org/cd/poly -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/poly">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD contains generic operators to deal with various forms
     of polynomials. The arithmetic operators from arith1 etc. are valid
     on these polynomials: there is also the operator &quot;power&quot; from this
     CD, which creates formal powers. 
     More specific operations for Distributed Multivariate Polynomials
     can be found in polyd.ocd, and for Recursive polynomials in polyr.ocd.</OM-Math-Meta:description>
        <rdfs:comment>Definition of operations</rdfs:comment>
        <rdfs:comment>Definition of some constructors</rdfs:comment>
        <rdfs:comment>Original OpenMath v1.1 Poly 1997
Update to Current Format 1999-07-07 DPC
Move the names of rings to setname.ocd 1999-11-09 JHD
Split into poly{,d,r} 1999-11-14 JHD
Updated following Abbott/Strotmann/Davenport at Dagstuhl October 2001 JHD</rdfs:comment>
