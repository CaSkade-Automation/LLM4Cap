    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/plangeo1#assertion -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/plangeo1#assertion">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1632"/>
        <OM-Math-Meta:description>The symbol is a constructor with two arguments.
Its first argument should be a 
configuration, its second argument a statement about the
configuration, called thesis.
When applied to a configuration C and a thesis T, the OpenMath object assertion(C,T)
expresses the assertion that T holds in C.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/plangeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1632">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/plangeo1#configuration -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/plangeo1#configuration">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1634"/>
        <OM-Math-Meta:example rdf:nodeID="genid1636"/>
        <OM-Math-Meta:example rdf:nodeID="genid1638"/>
        <OM-Math-Meta:description>The symbol represents a configuration in Euclidean 
planar geometry consisting of a sequence of geometric objects like points,
lines,  etc, but also of other configurations.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/plangeo1"/>
    </owl:NamedIndividual>
