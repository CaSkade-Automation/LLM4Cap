    <!-- http://www.openmath.org/cd/logic1#xor -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#xor">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1208"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1212"/>
        <OM-Math-Meta:commentedProperty>for all x | x xor not(x) = true</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x | x xor x = false</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the logical xor function which is an n-ary
function taking boolean arguments and returning a boolean
value. It is true if there are an odd number of true arguments or
false otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
