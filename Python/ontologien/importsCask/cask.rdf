    <!-- http://www.openmath.org/cd/logic3#complete_prop_theorem -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic3#complete_prop_theorem">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1232"/>
        <OM-Math-Meta:description>This symbol is used to state, with proof (the second child), that a
statement (the first child) is a theorem of the classical propositional
calculus, i.e. that it follows by applications of Modus Ponens from
instantiations of the axioms (which may be the common three involving
&apos;implies&apos;, but need not be).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1232">
