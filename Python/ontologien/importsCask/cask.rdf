    <!-- http://www.openmath.org/cd/relation1#ne -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#ne"/>
    


    <!-- http://www.openmath.org/cd/relation1#neq -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#neq">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1890"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1892"/>
        <OM-Math-Meta:commentedProperty>it is not true that a=/b and b=/c implies a=/c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the binary inequality function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1890">
