    <!-- http://www.openmath.org/cd/arith1#unary_minus -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith1#unary_minus">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid325"/>
        <OM-Math-Meta:commentedProperty>for all a | a + (-a) = 0</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol denotes unary minus, i.e. the additive inverse.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/arith1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid325">
