        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/field2#conjugation -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/field2#conjugation">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid562"/>
        <OM-Math-Meta:commentedProperty>conjugation(M,x) (y) = x * y * x^ {-1}.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a field M
and a nonzero element x of M.
When applied to M and x, it denotes conjugation on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/field2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid562">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
