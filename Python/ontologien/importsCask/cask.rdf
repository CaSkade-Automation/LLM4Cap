        <OM-Math-Meta:formalProperty rdf:nodeID="genid461"/>
        <OM-Math-Meta:commentedProperty>energy = force*length</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>energy = mass*length^2/time^2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the energy physical dimension.</OM-Math-Meta:description>
