    <!-- http://www.openmath.org/cd/physical_consts1#Planck_constant -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#Planck_constant">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1612"/>
        <OM-Math-Meta:commentedProperty>The Planck constant is 6.6260755*10^(-34) +/- 4.0*10^(-40) Joule
seconds 

this is equivalent to

There exists P s.t. 
  6.626075... -4.0... &lt; P 
    and
  6.626075... +4.0... &gt; P
    and
  Planck constant = P*Joule*second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the fundamental constant equal to the ratio of
the energy of a quantum of energy to its frequency. It is
approximately equal to 6.6260755*10^(-34) +/- 4.0*10^(-40) Joule seconds.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1612">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#exists"/>
        <OM-Math:body rdf:nodeID="genid1613"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
