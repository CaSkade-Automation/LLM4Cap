        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo0#gamma -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo0#gamma">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid879"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid881"/>
        <OM-Math-Meta:commentedProperty>gamma(z)=\int_0^{+\infty} t^{z-1} e^{-z} dt (Re(z)&gt;0)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Euler&apos;s gamma function</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo0"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid879">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid881">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo0#pochhammer -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo0#pochhammer">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid883"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid885"/>
        <OM-Math-Meta:commentedProperty>pochhammer(a,n) = gamma(a+n)/gamma(a)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Pochhammer symbol</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo0"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid883">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid885">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo1#hypergeometric0F1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo1#hypergeometric0F1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid887"/>
        <OM-Math-Meta:commentedProperty>hypergeometric0F1(;a;z)
	=\sum_{n=0}^{+\infty}
	\frac{1}{pochhammer(a,n)pochhammer(1,n)} z^n</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Hypergeometric function {}_0 F_1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid887">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo1#hypergeometric1F1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo1#hypergeometric1F1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid889"/>
        <OM-Math-Meta:commentedProperty>hypergeometric1F1(a,b;z)
	=\sum_{n=0}^{+\infty}
	\frac{pochhammer(a,n)}{pochhammer(1,n)pochhammer(b,n)} z^n</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Kummer&apos;s confluent hypergeometric function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid889">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo1#hypergeometric2F1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo1#hypergeometric2F1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid891"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid893"/>
        <OM-Math-Meta:commentedProperty>hypergeometric2F1(a,b,c;z)
	=\sum_{n=0}^{+\infty}
	\frac{pochhammer(a,n)pochhammer(b,n)}{pochhammer(c,n)pochhammer(1,n)} z^n</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The Gauss hypergeometric function.
	This function has a branch cut on [1,+infinity).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid891">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid893">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo1#hypergeometric_pFq -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo1#hypergeometric_pFq">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid895"/>
        <OM-Math-Meta:commentedProperty>hypergeometric_pFq(a,b;z)
	=\sum_{n=0}^{+\infty}
	\frac{\Pi_i pochhammer(a_i,n)}{\Pi_i pochhammer(b_i,n)pochhammer(1,n)} z^n</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Generalized hypergeometric function.
	This function has a branch cut on [1,+infinity).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid895">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeon0#cartesian_product_n -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#cartesian_product_n">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid897"/>
        <OM-Math-Meta:commentedProperty>$ Z^m \times Z^n = Z^{m+n} $</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>the cartesian product of n copies of the first argument.
  Binary function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid897">
