        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#Energy"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI2206#Information -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Information">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#Information"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI2206#Module -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Module">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI2206#Product -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#Product">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#Product"/>
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/css#Product"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI2206#System -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/VDI2206#System">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#Process -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#Process">
        <owl:equivalentClass rdf:resource="http://www.w3id.org/hsu-aut/css#Process"/>
    </rdf:Description>
    


    <!-- http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/VDI3682#TechnicalResource">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Resource"/>
    </rdf:Description>
    


    <!-- http://www.w3id.org/hsu-aut/cask#CurrentStateOutput -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#CurrentStateOutput">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillOutput"/>
        <rdfs:comment>May be used to get the current state as an integer value</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#GetOutputs -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#GetOutputs">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#StatelessMethod"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#ProvidedCapability -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#ProvidedCapability">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#RequiredCapability -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#RequiredCapability">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#SetParameters -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#SetParameters">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#StatelessMethod"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#SkillCommand -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#SkillCommand">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/css#SkillParameter"/>
        <rdfs:comment>May be used to invoke a transition with a numerical value</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#SkillMethod -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#SkillMethod">
        <rdfs:comment>Abstract concept of a method to invoke a skill. Needs to be implemented and modeled in detail for a specific technology</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#SkillOutput -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#SkillOutput">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
        <rdfs:comment>May be used to retrieve results during or after Skill execution</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#SkillVariable -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#SkillVariable">
        <rdfs:comment>A super class for various types of Skill variables: 
- SkillCommand: Allows to control a skill via a numeric command value
- SkillParameter: Allows to parameterize a Skill execution
- SkillOutput: Allows to retrieve results from a Skill</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#StatefulMethod -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#StatefulMethod">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillMethod"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/cask#StatelessMethod -->

    <owl:Class rdf:about="http://www.w3id.org/hsu-aut/cask#StatelessMethod">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillMethod"/>
    </owl:Class>
    


    <!-- http://www.w3id.org/hsu-aut/css#CapabilityConstraint -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/css#CapabilityConstraint">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://openmath.org/vocab/math#Application"/>
                    <owl:Restriction>
                        <owl:onProperty>
                            <rdf:Description>
                                <owl:inverseOf rdf:resource="http://www.w3id.org/hsu-aut/css#isRestrictedBy"/>
                            </rdf:Description>
                        </owl:onProperty>
                        <owl:someValuesFrom rdf:resource="http://www.w3id.org/hsu-aut/css#Capability"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
    </rdf:Description>
    


    <!-- http://www.w3id.org/hsu-aut/css#SkillParameter -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/css#SkillParameter">
        <rdfs:subClassOf rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
    </rdf:Description>
    


