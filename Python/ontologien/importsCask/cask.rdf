        <OM-Math-Meta:description>Successor function on the natural number. 
           Constructor for the inductively defined natural numbers. 
           Takes argument a a natural number and returns a natural
           number.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/indnat"/>
