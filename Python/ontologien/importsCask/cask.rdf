        <OM-Math-Meta:example rdf:nodeID="genid2349"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2351"/>
        <OM-Math-Meta:commentedProperty>-pi &lt; Im ln x &lt;= pi</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the ln function (natural logarithm) as
described in Abramowitz and Stegun, section 4.1. It takes one
argument.  Note the description in the CMP/FMP of the branch cut.  If
signed zeros are in use, the inequality needs to be non-strict.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
