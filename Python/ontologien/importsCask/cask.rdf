    <!-- http://www.openmath.org/cd/calculus1#int -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/calculus1#int">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid375"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid377"/>
        <OM-Math-Meta:commentedProperty>application of integrate followed by differentiate is the identity
function, that is: 
 diff(lambda y:integral(lambda z:f(z))(y)) = f</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent indefinite integration of unary functions.
The argument is the unary function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/calculus1"/>
    </owl:NamedIndividual>
