        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation1#gt -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#gt">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1878"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1880"/>
        <OM-Math-Meta:commentedProperty>a&gt;b and b&gt;c implies a&gt;c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the binary greater than function which returns
true if the first argument is greater than the second, it returns false
otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1878">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
