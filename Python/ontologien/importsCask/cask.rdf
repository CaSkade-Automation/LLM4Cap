        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid57"/>
        <OM-Math-Meta:description>The symbol is used to indicate the set of the two endpoints of a segment in 3-dimensional Euclidean geometry by
a variable. The symbol takes the variable as the first argument and the segment as second argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo1"/>
    </owl:NamedIndividual>
