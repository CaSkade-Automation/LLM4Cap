    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/intpath1#circle_with_starting_point">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid977"/>
        <OM-Math-Meta:description>The symbol circle_with_starting_point(c,r,z0) is the circle 
  in the Riemann sphere of which center is c and the radius is r.
  The direction of the circle is the counter clockwise and
  the staring point is z0.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/intpath1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid977">
