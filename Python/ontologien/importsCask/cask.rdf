    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/calculus1#nthdiff">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid379"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid381"/>
        <OM-Math-Meta:description>This symbol is used to express the nth-iterated ordinary differentiation of 
a unary function. The first argument is n, and the second the unary function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/calculus1"/>
    </owl:NamedIndividual>
