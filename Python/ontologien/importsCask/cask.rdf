    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation1#lt -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#lt">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1886"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1888"/>
        <OM-Math-Meta:commentedProperty>a&lt;b and b&lt;c implies a&lt;c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the binary less than function which returns
true if the first argument is less than the second, it returns false
otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1886">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
