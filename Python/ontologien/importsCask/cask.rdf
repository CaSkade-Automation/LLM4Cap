    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/3Dgeo2#line_parallel -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#line_parallel">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid81"/>
        <OM-Math-Meta:description>The symbol represents a binary boolean function with input two lines or segments.
Its value is true whenever the first argument is parallel to the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid81">
