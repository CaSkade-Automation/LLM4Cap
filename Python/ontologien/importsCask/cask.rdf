    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#sphere_center">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid89"/>
        <OM-Math-Meta:description>The statement that a sphere in 3-dimensional Euclidean space has a given point as center. 
Takes the sphere as first argument and the point as second argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
