    <!-- http://www.openmath.org/cd/physical_consts1#Boltzmann_constant -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#Boltzmann_constant">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1600"/>
        <OM-Math-Meta:commentedProperty>The Boltzmann constant is equal to 1.380658*10^(-23) +/- 1.2*10^(-28)
Joules per Kelvin.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A constant which describes the relationship between temperature and kinetic energy for
molecules in an ideal gas. It is approximately 1.380658*10^(-23)
 +/- 1.2*10^(-28) Joules per Kelvin.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
