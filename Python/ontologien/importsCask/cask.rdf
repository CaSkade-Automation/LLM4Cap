        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/FundamentalPhysicalConstants1#Planck%20temperature -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/FundamentalPhysicalConstants1#Planck%20temperature">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid103"/>
        <OM-Math-Meta:commentedProperty>l_P =  sqrt(h-bar*c^5/(G*k^3))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>l_P ~ 1.416785(71) × 10^32 kelvin</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The Planck temperature is defined to be sqrt(h-bar*c^5/(G*k^3)).
Its value derived from measurement is 1.416785(71) × 10^32 kelvin.
It is commonly represented with the short, italic symbol, &quot;T&quot;, subscripted with an upright capital &quot;P&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/FundamentalPhysicalConstants1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid103">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/FundamentalPhysicalConstants1#Planck%20time -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/FundamentalPhysicalConstants1#Planck%20time">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid105"/>
        <OM-Math-Meta:commentedProperty>t_P = sqrt(h-bar*G/(c^5))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>t_P ~  5.39124(27) * 10^−44 second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The Planck time is defined to be sqrt(h-bar*G/(c^5)).
Its value derived from measurement is 5.39124(27) * 10^−44 second.
It is commonly represented with the short, italic symbol, &quot;t&quot;, subscripted with an upright capital &quot;P&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/FundamentalPhysicalConstants1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid105">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
