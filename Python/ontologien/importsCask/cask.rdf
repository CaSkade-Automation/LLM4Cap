    <!-- http://www.openmath.org/cd/dimensions1#charge -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#charge">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>charge = current/voltage</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the charge physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#concentration -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#concentration">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>concentration = mass/length^3</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the concentration physical dimension, it is the
amount of a substance in a volume.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#current -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#current">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>current = voltage*charge</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the current physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#density -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#density">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid459"/>
        <OM-Math-Meta:commentedProperty>density = mass/volume</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the density physical dimension, it is the mass
per unit volume.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid459">
