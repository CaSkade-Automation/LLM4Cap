        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic1#implies -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#implies">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1190"/>
        <OM-Math-Meta:commentedProperty>for all x | false implies x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the logical implies function which takes two
boolean expressions as arguments. It evaluates to false if the first
argument is true and the second argument is false, otherwise it
evaluates to true.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1190">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid1191"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
