    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic3#Hypothesis -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic3#Hypothesis">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1218"/>
        <OM-Math-Meta:description>This symbol represents that a wellformed formula is a hypothesis of a
deduction of the propositional or predicate calculus.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic3"/>
    </owl:NamedIndividual>
