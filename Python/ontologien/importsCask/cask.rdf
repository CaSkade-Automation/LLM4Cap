    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#pressure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid469"/>
        <OM-Math-Meta:commentedProperty>pressure = force/area</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the pressure physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid469">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/dimensions1#resistance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#resistance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>resistance = voltage/current</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the resistance physical dimension, it is the
resistance that an electrical circuit has to flow of charge.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#speed -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#speed">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid471"/>
        <OM-Math-Meta:commentedProperty>speed = length/time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the speed physical dimension. It is the size of the
derivative of distance with respect to time.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid471">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/dimensions1#temperature -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#temperature">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents the temperature physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#time -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#time">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents the time physical dimension.
Note that the main units for time are defined in the units_time1 CD.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#velocity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#velocity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid473"/>
        <OM-Math-Meta:commentedProperty>speed is the Euclidean norm of velocity</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>velocity = displacement/second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the velocity physical dimension. It is the
derivative of (vector) distance with respect to time.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid473">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
