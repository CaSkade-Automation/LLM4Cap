    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://openmath.org/vocab/math#Application -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Application">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Compound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#arguments"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#ObjectList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#operator"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#operator"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#arguments"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Constructs an OpenMath object from a sequence of one or more OpenMath objects. The first child of an application is referred to as its &quot;head&quot; while the remaining objects are called its &quot;arguments&quot;.  An OpenMath application object can be used to convey the mathematical notion of application of a function to a set of arguments.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Attribution -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Attribution">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Compound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#arguments"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#AttributionList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#target"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#target"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#arguments"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Decorates an object with a sequence of one or more pairs made up of an OpenMath symbol, the &quot;attribute&quot;, and an associated  object, the &quot;value of the attribute&quot;. The value of the attribute can be an OpenMath attribution object itself. As an example of this, consider the OpenMath objects representing groups, automorphism groups, and group dimensions. It is then possible to attribute an OpenMath object representing a group by its automorphism group, itself attributed by its dimension.

OpenMath objects can be attributed with OpenMath foreign objects, which are containers for non-OpenMath structures. For example a mathematical expression could be attributed with its spoken or visual rendering.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#AttributionList -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#AttributionList">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#AttributionPair"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#rest"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#AttributionList"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#AttributionPair"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A list of attribute-value pairs.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#AttributionPair -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#AttributionPair">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#attributeKey"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Symbol"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#attributeValue"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#attributeKey"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#attributeValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Maps an attribute key to the corresponding attribute value.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Binding -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Binding">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Compound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#binder"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#body"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#variables"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#VariableList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#binder"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#body"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#variables"/>
                <owl:maxCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:maxCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A variable binding that is constructed from an OpenMath object, and from a sequence of zero or more variables followed by another OpenMath object.  The binding consits of a &quot;binder&quot; object, the &quot;body&quot; and the &quot;variables&quot; to be bound in the &quot;body&quot;. It is allowed to have no bound variables, but the binder object and the body should be present. Binding can be used to express functions or logical statements.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Compound -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Compound">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:comment>An object that is composed of some other mathematical objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Error -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Error">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Compound"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#arguments"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#ObjectList"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#symbol"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Symbol"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#symbol"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Represents error objects which are made up of an OpenMath symbol and a sequence of zero or more OpenMath objects. This object has no direct mathematical meaning.  Errors occur as the result of some treatment on an OpenMath object and are thus of real interest only when some sort of communication is taking place. Errors may occur inside other objects and also inside other errors. Error objects might consist only of a symbol as in the object: error (S).</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Foreign -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Foreign">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#encoding"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#value"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A non-OpenMath object within an OpenMath attribution. Examples of its use could be to annotate a formula with a visual or aural rendering, an animation, etc. They may also appear in OpenMath error objects, for example to allow an application to report an error in processing such an object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Literal -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Literal">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#value"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>An OpenMath literal (integer, float, character string, bytearray).</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Object -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Object">
        <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
        <rdfs:comment>Component of a mathematical expression.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#ObjectList -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#ObjectList">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#rest"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#ObjectList"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A list of mathematical objects.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Reference -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Reference">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#target"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#target"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Symbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Symbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math/meta#example"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math/meta#formalProperty"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Object"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Symbols are uniquely defined by the Content Dictionary in which they occur and by a name. Each symbol has no more than one definition in a Content Dictionary. Many Content Dictionaries may define differently a symbol with the same name (e.g. the symbol union is defined as associative-commutative set theoretic union in a Content Dictionary set1 but another Content Dictionary, multiset1 might define a symbol union as the union of multi-sets).</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#Variable -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#Variable">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Object"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#name"/>
                <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://openmath.org/vocab/math#name"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>Denote parameters, variables or indeterminates (such as bound variables of function definitions, variables in summations and integrals, independent variables of derivatives).</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math#VariableList -->

    <owl:Class rdf:about="http://openmath.org/vocab/math#VariableList">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#Variable"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#rest"/>
                        <owl:someValuesFrom rdf:resource="http://openmath.org/vocab/math#Variable"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#first"/>
                <owl:allValuesFrom rdf:resource="http://openmath.org/vocab/math#Variable"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>A list of variables.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#ApplicationSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#ApplicationSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>The symbol may appear as the first child of an OpenMath application object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#AttributionSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#AttributionSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>The symbol may be used as key in an OpenMath attribution object, i.e. as the first element of a (key, value) pair, or in an equivalent context (for example to refer to the value of an attribution).  This form of attribution
may be ignored by an application, so should be used for information which does not change the meaning of the attributed OpenMath object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#BinderSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#BinderSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>The symbol may appear as the first child of an OpenMath binding object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#ConstantSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#ConstantSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>The symbol cannot be used to construct an OpenMath compound object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#ErrorSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#ErrorSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>The symbol may appear as the first child of an OpenMath error object.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#Library -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#Library">
        <rdfs:comment>Represents a collection of related OpenMath symbols.</rdfs:comment>
    </owl:Class>
    


    <!-- http://openmath.org/vocab/math/meta#SemanticAttributionSymbol -->

    <owl:Class rdf:about="http://openmath.org/vocab/math/meta#SemanticAttributionSymbol">
        <rdfs:subClassOf rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <rdfs:comment>This is the same as attribution except that it modifies the meaning of the attributed OpenMath object and thus cannot be ignored by an application, without changing the meaning.</rdfs:comment>
    </owl:Class>
    


    <!-- http://www.w3.org/1999/02/22-rdf-syntax-ns#List -->

    <owl:Class rdf:about="http://www.w3.org/1999/02/22-rdf-syntax-ns#List"/>
    


