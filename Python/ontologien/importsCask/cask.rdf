        <OM-Math-Meta:example rdf:nodeID="genid1178"/>
        <OM-Math-Meta:description>This symbol represents a function with two arguments,
the first of which is a natural number and the second of which is a list.
The first argument is the length of the list.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/list3"/>
    </owl:NamedIndividual>
