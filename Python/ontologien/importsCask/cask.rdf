        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1996">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ringname1#Zm -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ringname1#Zm">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1998"/>
        <OM-Math-Meta:description>This symbol represents the ring of integers modulo m, where m is not necessarily
a prime. It takes one argument, the integer m.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ringname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1998">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
