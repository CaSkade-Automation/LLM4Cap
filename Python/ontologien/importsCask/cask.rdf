        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic1#not -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic1#not">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1194"/>
        <OM-Math-Meta:commentedProperty>for all x | not(not(x))=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the logical not function which takes one boolean
argument, and returns the opposite boolean value.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic1"/>
    </owl:NamedIndividual>
