    <!-- http://www.openmath.org/cd/combinat1#Bell -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/combinat1#Bell">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid395"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid397"/>
        <OM-Math-Meta:commentedProperty>Bell(n) = the sum from k=0 to n of Stirling2(n,k)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The Bell numbers: Bell(n) is the total number of possible partitions of a set
of n elements.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/combinat1"/>
    </owl:NamedIndividual>
