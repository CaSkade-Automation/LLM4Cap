        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/list1#suchthat -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/list1#suchthat">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1136"/>
        <OM-Math-Meta:description>This symbol represents the suchthat function which may be used to
construct lists; it takes two arguments. The first argument should be a
set X which contains the elements of the list, the second argument should
be a predicate, that is a function from the set X to the booleans which
describes if an element is to be in the list returned.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/list1"/>
    </owl:NamedIndividual>
