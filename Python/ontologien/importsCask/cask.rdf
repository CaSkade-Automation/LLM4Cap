        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc3#arccsc -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arccsc">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2417"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2419"/>
        <OM-Math-Meta:commentedProperty>arccsc(z) = -i ln (sqrt(1-1/z^2)+i/z), but the multivalued equivalent is
Arccsc(z) = -i Ln (Sqrt(1-1/z^2)+i/z), which we translate into OpenMath as 
Arccsc(z) = -i [ Ln (sqrt(1-1/z^2)+i/z) union  Ln (-sqrt(1-1/z^2)+i/z),</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arccsc(x) &lt;=&gt; csc(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the multivalued arccsc function as the inverse of
csc.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2417">
