    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Literal"/>
        <OM-Math:value>slpDegree(convert(x^2)@poly_ring_SLP - convert(x^2)@poly_ring_SLP) = 2</OM-Math:value>
    </rdf:Description>
