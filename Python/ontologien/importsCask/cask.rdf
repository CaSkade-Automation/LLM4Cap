    <!-- http://www.openmath.org/cd/transc1#arctanh -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arctanh">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2323"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2325"/>
        <OM-Math-Meta:commentedProperty>arctanh(z) = - i * arctan(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x where 0 &lt;= x^2 &lt; 1 |
arctanh(x) = 1/2 * ln((1 + x)/(1 - x))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arctanh function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
