<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.w3id.org/hsu-aut/cask#"
     xml:base="http://www.w3id.org/hsu-aut/cask"
     xmlns:CSS="http://www.w3id.org/hsu-aut/css#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:PackML="http://www.w3id.org/hsu-aut/PackML#"
     xmlns:OM-Math="http://openmath.org/vocab/math#"
     xmlns:VDI2206="http://www.w3id.org/hsu-aut/VDI2206#"
     xmlns:VDI3682="http://www.w3id.org/hsu-aut/VDI3682#"
     xmlns:DINEN61360="http://www.w3id.org/hsu-aut/DINEN61360#"
     xmlns:OM-Math-Meta="http://openmath.org/vocab/math/meta#">
    <owl:Ontology rdf:about="http://www.w3id.org/hsu-aut/cask">
        <owl:versionIRI rdf:resource="http://www.w3id.org/hsu-aut/cask/2.5.4"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/DINEN61360.rdf"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/PackML.rdf"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/VDI2206.rdf"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/VDI3682.rdf"/>
        <owl:imports rdf:resource="http://www.w3id.org/hsu-aut/css.rdf"/>
        <rdfs:comment>A domain ontology to describe capabilities and skills. This ontology extends the concepts defined in the CSS ontology (https://github.com/hsu-aut/css-ontology) by using ontology design patterns for different standards.</rdfs:comment>
        <owl:versionInfo>2.5.4</owl:versionInfo>
    </owl:Ontology>
    


