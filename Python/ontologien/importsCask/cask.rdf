        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AsymmetricProperty"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/css#Skill"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/PackML#State"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasCurrentStateOutput -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasCurrentStateOutput">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/hsu-aut/cask#hasSkillOutput"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasSkillCommand -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasSkillCommand">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/hsu-aut/css#hasParameter"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/css#Skill"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillCommand"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasSkillMethod -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasSkillMethod">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/css#Skill"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillMethod"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasSkillOutput -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasSkillOutput">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/hsu-aut/cask#hasSkillVariable"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/css#Skill"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillOutput"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasSkillVariable -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasSkillVariable">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/css#Skill"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#invokes -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#invokes">
        <owl:inverseOf rdf:resource="http://www.w3id.org/hsu-aut/cask#isInvokedBy"/>
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillMethod"/>
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/PackML#Transition"/>
    </owl:ObjectProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#isInvokedBy -->

    <owl:ObjectProperty rdf:about="http://www.w3id.org/hsu-aut/cask#isInvokedBy"/>
    


    <!-- http://www.w3id.org/hsu-aut/css#exposes -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/css#exposes">
        <rdfs:range rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillMethod"/>
    </rdf:Description>
    


    <!-- http://www.w3id.org/hsu-aut/css#hasParameter -->

    <rdf:Description rdf:about="http://www.w3id.org/hsu-aut/css#hasParameter">
        <rdfs:subPropertyOf rdf:resource="http://www.w3id.org/hsu-aut/cask#hasSkillVariable"/>
    </rdf:Description>
    


