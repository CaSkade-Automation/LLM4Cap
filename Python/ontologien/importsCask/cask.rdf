    <!-- http://www.openmath.org/cd/setname2#Boolean -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#Boolean">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2205"/>
        <OM-Math-Meta:commentedProperty>for all b in the booleans | (there exists an nb in the booleans | 
nb not= b implies nb = not b)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of Booleans. That is the truth values,
true and false.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2205">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
