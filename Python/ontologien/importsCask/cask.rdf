    <!-- http://www.openmath.org/cd/relation1#eq -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#eq">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1870"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1872"/>
        <OM-Math-Meta:commentedProperty>a=b and b=c implies a=c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the binary equality function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1870">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
