    <!-- http://www.openmath.org/cd/transc1#arcsec -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arcsec">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2299"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2301"/>
        <OM-Math-Meta:commentedProperty>arcsec(z) = -i ln(1/z + i \sqrt(1-1/z^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all z | arcsec z = i * arcsech z</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arcsec function as described in Abramowitz
and Stegun, section 4.4.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2299">
