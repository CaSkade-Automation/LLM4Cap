    <owl:DatatypeProperty rdf:about="http://openmath.org/vocab/math#name">
        <rdfs:comment>Represents the name of a variable.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://openmath.org/vocab/math#value -->

    <owl:DatatypeProperty rdf:about="http://openmath.org/vocab/math#value">
        <rdfs:comment>Represents the value of a literal or a foreign object.</rdfs:comment>
    </owl:DatatypeProperty>
    


    <!-- http://openmath.org/vocab/math/meta#commentedProperty -->

    <owl:DatatypeProperty rdf:about="http://openmath.org/vocab/math/meta#commentedProperty"/>
    


    <!-- http://openmath.org/vocab/math/meta#description -->

    <owl:DatatypeProperty rdf:about="http://openmath.org/vocab/math/meta#description"/>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasDefaultValue -->

    <owl:DatatypeProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasDefaultValue">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasOptionValue -->

    <owl:DatatypeProperty rdf:about="http://www.w3id.org/hsu-aut/cask#hasOptionValue">
        <rdfs:domain rdf:resource="http://www.w3id.org/hsu-aut/cask#SkillVariable"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.w3id.org/hsu-aut/cask#hasVariableName -->

