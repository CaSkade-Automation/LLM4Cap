    <!-- http://www.openmath.org/cd/field3#field_by_poly -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/field3#field_by_poly">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid590"/>
        <OM-Math-Meta:description>This symbol is a binary function whose first argument is a univariate
polynomial ring R over a field, and whose second argument is an irreducible
polynomial f in this polynomial ring R. So, when applied to R and f, the
function has value the quotient ring R/(f).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/field3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid590">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
