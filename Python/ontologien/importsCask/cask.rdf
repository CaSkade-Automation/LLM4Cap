    <!-- http://www.openmath.org/cd/weylalgebra1#partialdiff -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/weylalgebra1#partialdiff">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2595"/>
        <OM-Math-Meta:commentedProperty>$\frac{\partial^{2} x^{2} y}{\partial x^{2}} = 2 y $</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>partial differentiation of a given function.</OM-Math-Meta:description>
