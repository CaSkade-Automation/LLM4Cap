    <!-- http://www.openmath.org/cd/polyu#polynomial_ring_u -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/polyu#polynomial_ring_u">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1830"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1832"/>
        <OM-Math-Meta:commentedProperty>Univariates are just recursive polynomials in one variable (though
	 constructed using isomorphic, but different, constructors).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The constructor of a univariate polynomial ring. The first argument
         is a ring (the ring of the coefficients), the second is the variable.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/polyu"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1830">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
