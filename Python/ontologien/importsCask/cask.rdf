        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/arith2#times -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith2#times">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid333"/>
        <OM-Math-Meta:commentedProperty>for all a,b | a * b = b * a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol representing an n-ary multiplication function inheriting
from the times in arith1, but with the extra property that here it must
be commutative.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/arith2"/>
    </owl:NamedIndividual>
