        <OM-Math-Meta:formalProperty rdf:nodeID="genid1604"/>
        <OM-Math-Meta:commentedProperty>Faradays constant is 96485.309 +/- 0.029 Coulombs per mole.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the electric charge carried by one mole of
electrons. It is approximately 96485.309 +/- 0.029 Coulombs per mole.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
