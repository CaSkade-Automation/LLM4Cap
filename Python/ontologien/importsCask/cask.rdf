    <!-- http://www.openmath.org/cd/3Dgeo2#perpendicular -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#perpendicular">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid85"/>
        <OM-Math-Meta:description>The symbol represents a binary boolean function with input two lines or segments.
Its value is true whenever the first argument is perpendicular to the second.</OM-Math-Meta:description>
