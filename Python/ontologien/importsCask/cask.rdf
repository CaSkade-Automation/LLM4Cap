    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#plane_parallel">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid87"/>
        <OM-Math-Meta:description>The symbol represents a binary boolean function with input two planes.
Its value is true whenever the first argument is parallel to the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
