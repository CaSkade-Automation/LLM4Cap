    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/list3#difference">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1170"/>
        <OM-Math-Meta:description>This symbol takes two arguments both a list. It represents a function which returns a list made up of all
the elements of the first list which are not in the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/list3"/>
    </owl:NamedIndividual>
