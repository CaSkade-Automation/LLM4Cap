        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#Celsius%20temperature -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#Celsius%20temperature">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid199"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid201"/>
        <OM-Math-Meta:commentedProperty>dim(Celsius temperature) = temperature</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>num(Celsius temperature) + 273.15 = num(temperature)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of Celsius temperature.
A variable representing an arbitrary quantity of temperature 
is commonly represented with the
italic, upper case letter, &quot;T&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid199">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid201">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#absorbed%20dose -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#absorbed%20dose">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid203"/>
        <OM-Math-Meta:commentedProperty>dim(absorbed dose) = dim(energy/mass)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of absorbed dose of ionizing radiation.
A variable representing an arbitrary quantity of absorbed dose 
is commonly represented with the
italic, upper case letter, &quot;D&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid203">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#catalytic%20activity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#catalytic%20activity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid205"/>
        <OM-Math-Meta:commentedProperty>dim(catalytic activity) = (amount of substance)/time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of catalytic activity,
an amount of catalyst that effects a rate of catalytic conversion of
an amount of substance.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid205">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#equivalent%20dose -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#equivalent%20dose">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid207"/>
        <OM-Math-Meta:commentedProperty>dim(equivalent dose) = dim(energy/mass)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of equivalent dose of ionizing
radiation. Equivalent dose is similar to absorbed dose but is weighted to
reflect differing biological effects and different radiation types.
A variable representing an arbitrary quantity of equivalent dose 
is commonly represented with the
italic, upper case letter, &quot;H&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid207">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#luminous%20flux -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#luminous%20flux">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid209"/>
        <OM-Math-Meta:commentedProperty>dim(luminous flux) = (luminous intensity)*dim(solid angle)
      =  (luminous intensity)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of luminous flux.
A variable representing an arbitrary quantity of luminous flux 
is commonly represented with the
italic, upper case letter, &quot;Φv&quot; (\phi; sub V).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid209">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#magnetic%20flux -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#magnetic%20flux">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid211"/>
        <OM-Math-Meta:commentedProperty>dim(magnetic flux) = dim(energy/current) =  mass*length^2/(current*time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of magnetic flux.
A variable representing an arbitrary quantity of magnetic flux 
is commonly represented with the
italic, upper case greek letter, &quot;\Phi;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid211">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#magnetic%20flux%20density -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#magnetic%20flux%20density">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid213"/>
        <OM-Math-Meta:commentedProperty>dim(magnetic flux density) = dim(magnetic flux)/(length^2)
      = mass/(current*time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of magnetic flux density.
A variable representing an arbitrary quantity of magnetic flux density 
is commonly represented
with the italic, upper case letter, &quot;B&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid213">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#moment%20of%20force -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#moment%20of%20force">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid215"/>
        <OM-Math-Meta:commentedProperty>dim(moment of force) = length*dim(force) = mass*length^2/(time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of force.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid215">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#solid%20angle -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#solid%20angle">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid217"/>
        <OM-Math-Meta:commentedProperty>dim(solid angle) = one</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the quantity of a two dimensional, geometric
      solid angle.
      A variable representing an arbitrary quantity of solid angle
      is commonly represented with the
      italic, upper case greek variable, &quot;\Omega;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid217">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_Functions1#dim -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_Functions1#dim"/>
    


    <!-- http://www.openmath.org/cd/SI_Functions1#num -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_Functions1#num"/>
    


    <!-- http://www.openmath.org/cd/SI_Functions1#unit -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_Functions1#unit"/>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#becquerel -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#becquerel">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(becquerel) = 1/(second)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of radio nuclide activity,
      or radioactivity. A becquerel of activity represents one nuclear
      decay event per second.
      It has the short symbol form, &quot;Bq&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#coulomb -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#coulomb">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(coulomb) = ampere*second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of electric charge.
      It has the short symbol form, &quot;C&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#degree-Celsius -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#degree-Celsius">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(degree Celsius) = unit(kelvin)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of Celsius temperature.
      It has the short symbol form, &quot;ºC&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#farad -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#farad">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(farad) = unit(coulomb/volt)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of electric capacitance.
      It has the short symbol form, &quot;F&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#gram -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#gram">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>gram = kilogram/1000</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents one gram. This unit is implied by the 
      incorporation of the prefix &quot;kilo&quot; in the base unit standard,
      kilogram. Since SI prefixes may not, by SI standard, be presented
      by prepending to &quot;kilogram&quot;, the gram is introduced for the
      application of prefixes. By itself, gram should not appear in
      SI compliant presentation.
      It has the short symbol form, &quot;g&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#gray -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#gray">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(gray) = unit(joule/kilogram)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of absorbed dose of ionizing,
      radiation. A gray of absorbed dose represents one joule of energy
      absorbed per kilogram of mass.
      It has the short symbol form, &quot;Gy&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#henry -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#henry">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(henry) = unit(volt*second/ampere)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of electrical inductance.
      It has the short symbol form, &quot;H&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#hertz -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#hertz">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(hertz) = one/second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of frequency.
      It has the short symbol form, &quot;Hz&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#joule -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#joule">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(joule) = unit(newton)*metre</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of energy.
      It has the short symbol form, &quot;J&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#katal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#katal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(katal) = mole/second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of equivalent dose of catalytic
      activity. A katal of catalytic activity represents the amount of
      catalyst to effect one mole of catalytic conversion per second.
      It has the short symbol form, &quot;kat&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#lumen -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#lumen">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(lumen) = unit(candela*steradian)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of luminous flux.
      It has the short symbol form, &quot;lm&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#lux -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#lux">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(lux) = unit(lumen/(metre^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of illuminance.
      It has the short symbol form, &quot;lx&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#newton -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#newton">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(newton) = kilogram*metre/second^2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of force. 
      It has the short symbol form, &quot;N&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#ohm -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#ohm">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(ohm) = unit(volt/ampere)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of electrical resistance.
      It has the short symbol form, &quot;\Omega;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#pascal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#pascal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(pascal) = unit(newton)/length^2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of pressure.
      It has the short symbol form, &quot;Pa&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#radian -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#radian">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>This is a dimensionless derived unit for the SI system. It
    is the angle subtended at the center of a circular arc with
    length the same as the radius of the corresponding circle.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>unit(radian) = 1</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents one radian, the natural unit of measure
    for angle.
    It has the short symbol form, &quot;rad&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#siemens -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#siemens">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(siemens) = unit(ampere/volt)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of electrical conductance. It is not plural.
      It has the short symbol form, &quot;S&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#sievert -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#sievert">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(sievert) = unit(joule/kilogram)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of equivalent dose of ionizing,
      radiation. A sievert of equivalent dose represents one joule of
      biologically damaging energy absorbed per kilogram of mass.
      It has the short symbol form, &quot;Sv&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#steradian -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#steradian">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>One steradian is defined as the solid angle subtended at the
    center of a sphere of radius r by a part of the surface of the
    sphere having an area r*r.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>unit(steradian) = 1</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents one steradian, the natural unit of
    measure for solid angle.
      It has the short symbol form, &quot;sr&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#tesla -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#tesla">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(tesla) = unit(weber)/(metre^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of magnetic flux density.
      It has the short symbol form, &quot;T&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#volt -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#volt">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(volt) = unit(joule/coulomb)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of voltage or electric tension.
      It has the short symbol form, &quot;V&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#watt -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#watt">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(watt) = unit(joule)/second</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of power, a joule per second.
      It has the short symbol form, &quot;W&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_NamedDerivedUnits1#weber -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_NamedDerivedUnits1#weber">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:commentedProperty>unit(weber) = unit(joule/ampere)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents an SI unit of magnetic flux.
      It has the short symbol form, &quot;Wb&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_NamedDerivedUnits1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_functions1#dim -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_functions1#dim">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>For named SI derived quantities and named units, the value returned
    by the dim operator shall be defined for each case.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator acts as the identity operation when applied to
    an SI base quantity.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator applied to a multiplicative inverse of a
    quantity is equal to the multiplicative inverse of the dim operator
    applied to the same quantity.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator applied to a product is equal to the associative
    product of the dim operator applied to the individual factors.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator applied to a product is equal to the commutative
    product of the dim operator applied to the factors.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator returns a value of one when applied to a
    dimensionless quantity or number.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The dim operator returns the corresponding SI base quantity when
    applied to an SI base unit.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent the function that returns the physical
      dimension of its argument in terms of products of powers of
      SI base quantities. The dim operation may be meaningfully applied to SI
      quantities, SI units, and numbers without physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_functions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_functions1#kind -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_functions1#kind">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>The symbol to represent the function to return the kind
      of a quantity. The value of this function is referred to, but not
      defined in the SI. Its value, kind(Q) for a given quantity, Q, is
      left to the user to assign.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_functions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_functions1#num -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_functions1#num">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>The num operator applied to an SI base quantity or unit returns
    the value one.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The num operator may be applied to any physical quantity.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The quantity num(Q)*unit(Q), may replace any quantity, Q, in
    a set of physical relations, if all such quantities in the set of
    relations are so replaced. The quantity num(Q)*unit(Q) is not always
    the same as Q, however dim(Q) = dim(num(Q)*unit(Q)).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent the function to return the numerical
      value of a quantity in terms of a product of powers of
      SI base units.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_functions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_functions1#unit -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_functions1#unit">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>The unit operator applied to a multiplicative inverse of a
    quantity is equal to the multiplicative inverse of the unit operator
    applied to the same quantity.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator applied to a product is equal to the
    associative product of the unit operator applied to the factors.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator applied to a product is equal to the
    commutative product of the unit operator applied to the factors.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator applied to an SI base quantity returns the
    corresponding SI base unit.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator applied to an SI base unit or SI coherent unit
    acts as the identity operator, returning that unit.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator applied to any derived quantity is equal to the 
    unit operator applied to the result of applying the dim operator to the
    same quantity, i.e., unit(Q) = unit(dim(Q)).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator may be applied to any physical quantity.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The unit operator returns a value of one when applied to a
    dimensionless quantity or number.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent the function that returns the units
      of its argument in terms of a product of powers of
      SI base units.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_functions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#aggregateType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#aggregateType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a generic type for aggregates (or collections
of objects.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#continuousSetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#continuousSetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid219"/>
        <OM-Math-Meta:commentedProperty>continuous set type has set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of continuous sets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid219">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/aggregate_cats#discreteSetType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/aggregate_cats#discreteSetType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid221"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid223"/>
        <OM-Math-Meta:commentedProperty>discrete set type does not have continuous set type or piecewise
continuous set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>discrete set type has set type</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the type of discrete sets.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/aggregate_cats"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid221">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta_cats#has"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid223">
