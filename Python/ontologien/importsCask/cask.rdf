    <!-- http://www.openmath.org/cd/weylalgebra1#act -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/weylalgebra1#act">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2585"/>
        <OM-Math-Meta:commentedProperty>$  x^{m} \partial_{x}^{n} \partial_{y}^{r} \cdot f 
   = x^{m} \frac{partial^{n+r} f}{\partial x^{n} \partial y^{r}}
  $</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>action of a differential operator to a function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/weylalgebra1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2585">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
