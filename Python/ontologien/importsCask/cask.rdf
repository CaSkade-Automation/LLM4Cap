    <!-- http://www.openmath.org/cd/hypergeon0#kernel -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#kernel">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid899"/>
        <OM-Math-Meta:commentedProperty>$\kernel(D,A) = \{ x \in D | A x = 0 \}$</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>It returns the kernel of the map defined by a matrix in a specified
 domain.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
