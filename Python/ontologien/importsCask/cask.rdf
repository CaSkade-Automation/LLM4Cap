    <!-- http://www.openmath.org/cd/logic3#Generalisation -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic3#Generalisation">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1216"/>
        <OM-Math-Meta:description>This symbol represents the generation of a line of a proof by application
of Generalisation. The first argument is the new well-formed formula
(forall x.B) and the second is the line number in the proof for B.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1216">
