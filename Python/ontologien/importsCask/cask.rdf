    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/dimensions1#area -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#area">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid457"/>
        <OM-Math-Meta:commentedProperty>area = length*length</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the area physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
