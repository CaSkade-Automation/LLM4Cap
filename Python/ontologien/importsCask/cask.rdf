    <!-- http://www.openmath.org/cd/arith1#gcd -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith1#gcd">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid277"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid279"/>
        <OM-Math-Meta:commentedProperty>for all integers a,b |
There does not exist a c such that a/c is an Integer and b/c is an
Integer and c &gt; gcd(a,b).

Note that this implies that gcd(a,b) &gt; 0</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent the n-ary function to return the gcd (greatest
common divisor) of its arguments.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/arith1"/>
    </owl:NamedIndividual>
