        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic3#is_deduction -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic3#is_deduction">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1234"/>
        <OM-Math-Meta:description>This symbol expresses whether or not there is a deduction of the form
quoted. Hence for items of type complete_pred_deduction, it is always true</OM-Math-Meta:description>
        <rdfs:comment>The Deduction Theorem (of propositional calculus).</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1234">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
