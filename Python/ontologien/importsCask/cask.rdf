        <OM-Math-Meta:formalProperty rdf:nodeID="genid2195"/>
        <OM-Math-Meta:commentedProperty>for all z | the statements z is an integer and z is a natural number
or -z is a natural number are equivalent</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of integers, positive, negative and zero.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
