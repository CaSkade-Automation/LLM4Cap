    <!-- http://www.openmath.org/cd/integer1#factorial -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/integer1#factorial">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid913"/>
        <OM-Math-Meta:commentedProperty>factorial n = product [1..n]</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent a unary factorial function on non-negative integers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/integer1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid913">
