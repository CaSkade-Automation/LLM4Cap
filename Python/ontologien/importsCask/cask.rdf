    <!-- http://www.openmath.org/cd/permutation1#perm -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/permutation1#perm">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1574"/>
        <OM-Math-Meta:example rdf:nodeID="genid1576"/>
        <OM-Math-Meta:description>This symbol is an n-ary function. Its
		arguments should be positive integers. When applied to
		arguments a_1,...,a_n, the resulting
		value is the permutation mapping i to a_i.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/permutation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1574">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
