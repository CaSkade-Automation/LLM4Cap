    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/logic3#ModusPonens -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/logic3#ModusPonens">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1220"/>
        <OM-Math-Meta:description>This symbol represents the generation of a line of a proof by application
of Modus Ponens. The first argument is the new well-formed formula (B),
the second is the line number in the proof for A and the third is the line
number in the proof for A implies B.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/logic3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1220">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
