        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/mathmltypes#constant_type -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/mathmltypes#constant_type">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1300"/>
        <OM-Math-Meta:description>A symbol to be used as the argument of the type symbol to convey a
type for the common constants, pi ~= 3.1415, e ~= 2.718, i = square
root of -1, gamma ~= .5772, NaN, infinity (all in the nums cd), true
and false (in the logic cd). Also for MathML variables declared to
have type constant, as in &lt;ci type=&quot;constant&quot;&gt;x&lt;/ci&gt;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/mathmltypes"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1300">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
