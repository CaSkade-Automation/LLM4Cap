    <!-- http://www.openmath.org/cd/arith1#times -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith1#times">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid315"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid317"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid321"/>
        <OM-Math-Meta:commentedProperty>for all a,b | a * 0 = 0 and a * b = a * (b - 1) + a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all a,b,c | a*(b+c) = a*b + a*c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol representing an n-ary multiplication function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/arith1"/>
    </owl:NamedIndividual>
