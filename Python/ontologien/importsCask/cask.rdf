    <!-- http://www.openmath.org/cd/plangeo2#corner -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/plangeo2#corner">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1648"/>
        <OM-Math-Meta:description>The corner between
two halflines L and M, both starting at the same point.  Given three
points A, B and C, the corner A, B, C is the corner of the two
halflines BA and BC.  Corresponding to the two cases, the symbol can
have as arguments two halflines or three points.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/plangeo2"/>
    </owl:NamedIndividual>
