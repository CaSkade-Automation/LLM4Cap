    <!-- http://www.openmath.org/cd/setname2#GFp -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#GFp">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2209"/>
        <OM-Math-Meta:commentedProperty>x^p = x mod p</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the finite field of integers modulo p, where p is a 
prime.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2209">
