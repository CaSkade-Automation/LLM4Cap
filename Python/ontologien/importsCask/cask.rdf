        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc1#arcsinh -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arcsinh">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2315"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2317"/>
        <OM-Math-Meta:commentedProperty>arcsinh z = ln(z + \sqrt(1+z^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>arcsinh(z) = - i * arcsin(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arcsinh function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
