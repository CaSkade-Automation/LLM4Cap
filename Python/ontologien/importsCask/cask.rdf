    <!-- http://www.openmath.org/cd/relation2#approx -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation2#approx">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>This symbol is used to denote the approximate equality of its two arguments.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation2"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relation3#class -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#class">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1894"/>
        <OM-Math-Meta:commentedProperty>class(S,R,a) = {b in S | (a,b) in R}.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a ternary function whose first argument is a set S,
whose second argument is a relation R on S, and whose third argument is an
element a of S.
When applied to S, R, and a, it represents the set of all elements in S
related to a by R, that is, the set {b in S | (a,b) in R}.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1894">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#classes -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#classes">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1896"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1898"/>
        <OM-Math-Meta:commentedProperty>The classes of a reflexive relation R on S cover S, as a in S belongs to class(S,R,a).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The classes of an equivalence relation R on S partition S.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a binary function whose first argument is a set S,
whose second argument is a relation R on S.
When applied to S and R, it represents the set of all elements in S
of the form class(S,R,a) for a in S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1896">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1898">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#equivalence_closure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#equivalence_closure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a binary function whose first argument is a set S,
whose second argument is a relation R on S.
When applied to S and R, it represents the smallest equivalence relation
(with respect to inclusion) on S containing R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relation3#is_equivalence -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#is_equivalence">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1900"/>
        <OM-Math-Meta:commentedProperty>R is an equivalence relation on S if and only if R is a symmetric, reflexive,
transitive relation on S.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean binary function which returns
true if and only if the second argument is a symmetric relation on the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1900">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#is_reflexive -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#is_reflexive">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1902"/>
        <OM-Math-Meta:commentedProperty>is_reflexive(S,R) if and only if, for all, a in S, we have (a,a) in R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean binary function which returns
true if and only if the second argument is a reflexive relation on the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1902">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#is_relation -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#is_relation">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1904"/>
        <OM-Math-Meta:commentedProperty>R a subset of S x S if and only if is_relation (S,R).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function of two arguments, S and R.
The first argument should be a set. When applied to S and R, the function
returns true if and only if the second argument  is a subset of the Cartesian
product of S with itself.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1904">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#is_symmetric -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#is_symmetric">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1906"/>
        <OM-Math-Meta:commentedProperty>is_symmetric(S,R) if and only if, for all a, b in S with (a,b) in R,
we have (b,a) in R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean binary function which returns
true if and only if the second argument is a symmetric relation on the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1906">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#is_transitive -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#is_transitive">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1908"/>
        <OM-Math-Meta:commentedProperty>R is transitive on S if and only if, for all a,b,c in S with
(a,b) in R and (b,c) in R, wehave (a,c) in R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the boolean binary function which returns
true if and only if the second argument is a transitive relation on the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1908">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/relation3#reflexive_closure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#reflexive_closure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a binary function whose first argument is a set S,
whose second argument is a relation R on S.
When applied to S and R, it represents the smallest reflexive relation
(with respect to inclusion) on S containing R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relation3#symmetric_closure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#symmetric_closure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a binary function whose first argument is a set S,
whose second argument is a relation R on S.
When applied to S and R, it represents the smallest symmetric relation
(with respect to inclusion) on S containing R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relation3#transitive_closure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation3#transitive_closure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a binary function whose first argument is a set S,
whose second argument is a relation R on S.
When applied to S and R, it represents the smallest transitive relation
(with respect to inclusion) on S containing R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relation4#eqs -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation4#eqs">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is used to denote the n-ary version of equality.
When applied to n arguments a1, ..., an, it represents the boolean expression
that
a1, a2, ,,, and an are equal.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/relations1#eq -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relations1#eq"/>
    


    <!-- http://www.openmath.org/cd/ring1#addition -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#addition">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1910"/>
        <OM-Math-Meta:description>This symbols represents a unary function, whose argument should be a
ring.  It returns the addition on the ring.
We will allow for the map to be n-ary.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1910">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#additive_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#additive_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1912"/>
        <OM-Math-Meta:description>This symbol is a unary function, whose argument should be a ring S.
When applied to S its value is the monoid underlying S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1912">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#carrier -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#carrier">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1914"/>
        <OM-Math-Meta:description>This symbol represents a unary function, whose argument should be a
ring S (for instance constructed by ring).
When applied to S, its value should be the set of elements of S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1914">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#expression -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#expression">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1916"/>
        <OM-Math-Meta:description>This symbol is a function with two arguments.  Its first
argument should be a ring. The
second should be an arithmetic expression A,
whose operators are
times, plus, minus, unary_minus, and power, and whose leaves are members of
the carrier of G. 
(Here an integer m will be interpreted as a member of G by interpreting it as 
the sum of m copies of the identity element, the symbol alg1.one will be
interpreted as the identity,
and  the symbol alg1.zero will be
interpreted as the zero of G.)
When applied to
G and A, it denotes the element (of G) that is the element obtained from the
leaves by applying the arithmetic operations of G instead of those
from the CD arith1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1916">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#identity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#identity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1918"/>
        <OM-Math-Meta:description>This symbols represents a unary function, whose argument should be a
ring.  It returns the identity element of the ring.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1918">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#is_commutative -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#is_commutative">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1920"/>
        <OM-Math-Meta:commentedProperty>If is_commutative(G) then for all a,b in carrier(G) a*b = b*a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The unary boolean function whose value is true iff the argument is a
commutative ring.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1920">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#is_subring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#is_subring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>If is_subring(G,H) then H is a nonempty set of elements of the carrier
of G and H is closed under multiplication and taking inverses.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The binary boolean function whose value is true iff the second
argument is a subring of the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring1#multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1922"/>
        <OM-Math-Meta:description>This symbol represents a unary function, whose argument should be a
ring S.  It returns the multiplication map on S.
We allow for the map to be n-ary.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1922">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#multiplicative_monoid -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#multiplicative_monoid">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1924"/>
        <OM-Math-Meta:description>This symbol is a unary function, whose argument should be a ring S.
When applied to S its value is the monoid underlying S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1924">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#negation -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#negation">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1926"/>
        <OM-Math-Meta:description>This symbol represents a unary function, whose argument should be a
ring S.  It returns the map sending an element of S to its additive inverse.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1926">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1928"/>
        <OM-Math-Meta:description>This is a symbol with two or three arguments.  Its first argument
should be a an element g of a ring and the second argument should be
an integer. The optional third argument is the ring G containing g.
It denotes the element g^k in G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1928">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1930"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1932"/>
        <OM-Math-Meta:commentedProperty>The distributive laws
m(x,a(y,z)) = a(m(x,y),m(x,z)) and
m(a(y,z),x) = a(m(y,x),m(z,x)),
where x,y,z are elements of R, should hold.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a constructor for rings. It takes six arguments
R,  a, o, i, m, e,: which are, respectively,
a set R to specify the elements in the ring, 
a binary operation a on R, an element o of R, and a unary
operation i on R such that [R,a,o,i] is a commutative group,
a
binary operation m on R and an element e of R such that
[R,m,e] is a monoid.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1930">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1932">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#subring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#subring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1934"/>
        <OM-Math-Meta:example rdf:nodeID="genid1936"/>
        <OM-Math-Meta:description>This symbol is a constructor symbol with one or two arguments. The
first argument is a list or set, D, of ring elements. The optional
second argument is the ring G containing D. It denotes the subring
of G generated by D.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1934">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1936">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#subtraction -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#subtraction">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1938"/>
        <OM-Math-Meta:description>This symbols represents a unary function, whose argument should be a
ring.  It returns the binary operation of subtraction on the ring.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1938">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring1#zero -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring1#zero">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1940"/>
        <OM-Math-Meta:description>This symbols represents a unary function, whose argument should be a
ring.  It returns the zero element of the ring.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1940">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#is_automorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#is_automorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1942"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1944"/>
        <OM-Math-Meta:commentedProperty>If is_automorphism(M,f) then is_isomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first is a ring M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes a ring automorphism f of  M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1942">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1944">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#is_endomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#is_endomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1946"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1948"/>
        <OM-Math-Meta:commentedProperty>If is_endomorphism(M,f) then is_homomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first argument is a ring M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes that f is a ring endomorphism from M
to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1946">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1948">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#is_homomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#is_homomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1950"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1952"/>
        <OM-Math-Meta:commentedProperty>If is_homomorphism(M,N,f) then, for each pair of elements x, y of M, we have
f(x * y) = f(x) * f(y).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first and arguments are rings M, N,
the third is a map f from the element set of M to the element set of N.
When applied to M, N, and f, it denotes that f is a ring homomorphism from M
to N.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1950">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1952">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#is_isomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#is_isomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1954"/>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first and arguments are rings M, N,
the third is a map f from the element set of M to the element set of N.
When applied to M, N, and f, it denotes that f is a ring isomorphism from M
to N.
This means that f is a homomorphism from M to N,
that f is bijective, and that its inverse  is a homomorphism from N to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1954">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#isomorphic -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#isomorphic">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1956"/>
        <OM-Math-Meta:description>This symbol is a Boolean function with n arguments, n at least 2, which are rings.
When applied to M_1, ..., M_n, it denotes the fact that there is an
isomorphism from each M_i to each M_j.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1956">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#left_multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#left_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1958"/>
        <OM-Math-Meta:commentedProperty>left_multiplication(M,x) (y) = x * y.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a ring M
and an element x of M.
When applied to M and x, it denotes left multiplication on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1958">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid1959"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1959">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring2#right_multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring2#right_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1962"/>
        <OM-Math-Meta:commentedProperty>right_multiplication(M,x) (y) = y * x.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a ring M
and an element x of M.
When applied to M and x, it denotes right multiplication on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1962">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid1963"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1963">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#direct_power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#direct_power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1966"/>
        <OM-Math-Meta:description>This is a symbol with two arguments.
The first argument should be a ring  S
and the second argument a positive integer n.
It denotes the direct product of n copies of S.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1966">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#direct_product -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#direct_product">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a symbol with two or more arguments, all of which are rings.  
It denotes the ring that is the direct product of its arguments.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring3#free_ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#free_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1968"/>
        <OM-Math-Meta:description>This symbol represents a binary function. The first argument should be a ring
and the second a list or a
set.  When evaluated on such arguments R and L, the function represents the
free ring over R generated by the elements (or entries) of L.
This ring can also be viewed as the ring of non-commutative polynomials over R
with variables the elements of L.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1968">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#ideal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#ideal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1970"/>
        <OM-Math-Meta:description>This symbol represents a
binary function. The first argument is a ring R and the second argument is a
list or a set.  When evaluated on R and such a second argument, the function
represents the ideal in R generated by the entries of the list or set.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1970">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#integers -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#integers">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1972"/>
        <OM-Math-Meta:commentedProperty>The ring of integers is (Z, +,0,-,*,1), where +,-,* are the standard
arithmetic operations.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This is a symbol representing the ring of integers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1972">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#invertibles -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#invertibles">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1974"/>
        <OM-Math-Meta:commentedProperty>The  carrier of the 
multiplicative group of the ring R is the set of invertible
elements of R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This is a unary function, whose argument is
a ring R. When applied to R,
it denotes the set of invertible elements of R with respect to the
multiplication on R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1974">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#is_ideal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#is_ideal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>If is_ideal(S,I) then I is a nonempty set of elements of S and I
is a subgroup of the additive group of S and
closed under multiplication by elements of S.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The binary boolean function whose value is true if and only if the second
argument is an ideal of the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring3#kernel -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#kernel">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1976"/>
        <OM-Math-Meta:commentedProperty>The kernel of a ring homomorphism is an ideal.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a
unary function. Its argument is a ring homomorphism f : R -&gt; S.  When evaluated on f, the function
represents the kernel in R of f, that is, the subset {x in R | f(x) = 0}.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1976">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#m_poly_ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#m_poly_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1978"/>
        <OM-Math-Meta:description>This symbol represents a binary function. The first argument should be a ring
and the second a list or a
set.  When evaluated on such arguments R and L, the function represents the
free commutative ring over R generated by the elements (or entries) of L.
This ring can also be viewed as the ring of polynomials over R
with variables the elements of L.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1978">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#matrix_ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#matrix_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1980"/>
        <OM-Math-Meta:commentedProperty>The ring of 1 x 1 matrices over R is isomorphic to R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a binary function. The first argument is a positive
integer n, the second is a
ring R.  When evaluated on such argument n and R, the function represents the
ring of n x n matrices over R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1980">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/ring2#isomorphic"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#multiplicative_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#multiplicative_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1982"/>
        <OM-Math-Meta:commentedProperty>The multiplicative group of the ring R is the group of invertible
elements of the multiplicative monoid of R.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This is a unary function, whose argument is
a ring R. When applied to R,
it denotes the group of invertible elements of R with respect to the
multiplication on R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1982">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#poly_ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#poly_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1984"/>
        <OM-Math-Meta:description>This symbol represents a binary function. The first argument should be a ring
and the second a variable.  When evaluated on such arguments R and X, the function represents the
free commutative ring over R generated by X.
This ring can also be viewed as the ring of polynomials over R 
with indeterminate X.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1984">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#principal_ideal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#principal_ideal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1986"/>
        <OM-Math-Meta:description>This symbol represents a
binary function. The first argument is a ring R and the second argument is an
element of R.  When evaluated on R and such a second argument, the function
represents the ideal in R generated by the second argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1986">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring3#quotient_ring -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring3#quotient_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1988"/>
        <OM-Math-Meta:example rdf:nodeID="genid1990"/>
        <OM-Math-Meta:description>This is a binary function, whose first argument is
a ring R and whose second argument is an ideal I of R.
When applied to R and I,
it denotes the quotient ring of R
by I.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1988">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1990">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring4#is_domain -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring4#is_domain">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a boolean 
unary function. The argument is a ring R.
When evaluated on R, the function returns true if R is a domain
and false otherwise. A domain is a commutative ring without zero divisors.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring4#is_field -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring4#is_field">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1992"/>
        <OM-Math-Meta:commentedProperty>If is_commutative(G) and for all a in carrier(G)
there is b in carrier(G) such that a*b =  identity(G), then is_field(G).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This is unary boolean function whose argument should be a ring R.
The value is true if and only if the ring is commutative and every nonzero 
element has
a multiplicative
inverse.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring4"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1992">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/ring4#is_maximal_ideal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring4#is_maximal_ideal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary boolean function whose value is true iff the second
argument is a maximal ideal of the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring4#is_prime_ideal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring4#is_prime_ideal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary boolean function whose value is true iff the second
argument is a prime ideal of the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring4#is_zero_divisor -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring4#is_zero_divisor">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>An element x of a ring R
is a zero divisor if and only if it
nonzero and there is a nonzero y in R such that x * y = 0 or y * x = 0.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a boolean 
binary function. The first argument is a ring R, the second is an element x of R.
When evaluated on R and x, the function returns true if x a zero divisor and
nonzero in R.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring5#automorphism_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring5#automorphism_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a function with a single argument which must be a ring.
It refers to the automorphism group of its argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring5"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring5#homomorphism_by_generators -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring5#homomorphism_by_generators">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a function with three arguments the first two of which must be monoids
F and K.
The third argument should be a set or a list L of ordered pairs (lists of length 2). Each
pair [x,y] from L consists of an element x from F and an element y from K.
when applied to F, K, and L, the symbol represents the monoid homomorphism from F
to K that maps the first entry x of each pair [x,y] to the second entry y of the same pair.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring5"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring5#quotient_by_poly_map -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring5#quotient_by_poly_map">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a binary function whose first argument is a 
ring R,
and whose
second argument is a univariate polynomial f with coefficients from R. So, if
the indeterminate is X,  when applied to R and f, the function has value the
natural quotient map from R[X] to the quotient ring R[X]/(f).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring5"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ring5#quotient_map -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ring5#quotient_map">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a binary function whose first argument is a ring R and whose
second argument is an ideal I of R. When applied to R and I, its value is the
natural quotient map from R to the quotient ring R/I.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ring5"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ringname1#Z -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ringname1#Z">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1994"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1996"/>
        <OM-Math-Meta:commentedProperty>The carrier set of this ring is the set of integers.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The integer 1 is the identity element of this ring.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the ring of integers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ringname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1994">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
