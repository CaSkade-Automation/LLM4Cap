    <!-- http://www.openmath.org/cd/list1#map -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/list1#map">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1134"/>
        <OM-Math-Meta:description>This symbol represents a mapping function which may be used to
construct lists; it takes as arguments a function from X to Y and a
list over X in that order. The value that is returned is a list of
values in Y. The argument list may be a set or an integer_interval.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/list1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1134">
