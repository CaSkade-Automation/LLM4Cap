    <!-- http://www.openmath.org/cd/complex1#imaginary -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/complex1#imaginary">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid447"/>
        <OM-Math-Meta:commentedProperty>for all x,y | y = imaginary(x+iy)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This represents the imaginary part of a complex number</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/complex1"/>
