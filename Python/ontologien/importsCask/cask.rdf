    <!-- http://www.openmath.org/cd/intpath1#circle -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/intpath1#circle">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid975"/>
        <OM-Math-Meta:description>The symbol circle(c,r) is the circle in the Riemann sphere of which
  center is c and the radius is r.
  The direction of the circle is the counter clockwise.
  When the center is intpath1.infty, the radius should be given in the 
  standard coordinate t=1/z at the infinity.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/intpath1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid975">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


