    <!-- http://www.openmath.org/cd/nums1#pi -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#pi">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1458"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1460"/>
        <OM-Math-Meta:commentedProperty>pi = 4 * the sum as j ranges from 0 to infinity of ((1/(4j+1))-(1/(4j+3)))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A symbol to convey the notion of pi, approximately 3.142.
The ratio of the circumference of a circle to its diameter.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
