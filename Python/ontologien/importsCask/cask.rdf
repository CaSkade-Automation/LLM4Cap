    <!-- http://www.openmath.org/cd/setname1#P -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname1#P">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2181"/>
        <OM-Math-Meta:commentedProperty>for all n |
n is a positive prime number is equivalent to:
n is a natural number and n &gt; 1 and
((n=a*b and a and b are natural numbers) implies ((a=1 and b=n) or
(b=1 and a=n)))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of positive prime numbers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2181">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
