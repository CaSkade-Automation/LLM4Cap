    <!-- http://www.openmath.org/cd/weylalgebra1#gr -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/weylalgebra1#gr">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2593"/>
        <OM-Math-Meta:commentedProperty>$\gr( q \partial_{q} + 1) = q p + 1 $</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>the symbol polynomial of a given differential operator.
  The inverse of diffop.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/weylalgebra1"/>
    </owl:NamedIndividual>
