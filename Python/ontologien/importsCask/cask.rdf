    <!-- http://www.openmath.org/cd/sts#attribution -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/sts#attribution">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2239"/>
        <OM-Math-Meta:description>An `attribution&apos; object consists of pairs of keys and values.  The use
of the symbol `attribution&apos; in a signature indicates that the symbol
is to be used as a key.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/sts"/>
    </owl:NamedIndividual>
