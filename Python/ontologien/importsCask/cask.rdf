    <!-- http://www.openmath.org/cd/transc2 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc2">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD holds the definition of a two-argument version of arctan,
    useful for defining the argument of a complex number, and equivalent
    to Fortran&apos;s ATAN2 function.
    It also holds a definition of the unwinding number, useful for writing
    correct relationships between elementary functions.</OM-Math-Meta:description>
