    <!-- http://www.openmath.org/cd/rounding1#round -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/rounding1#round">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2010"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2014"/>
        <OM-Math-Meta:commentedProperty>for all x | Also round to even in event of a tie</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x | x &lt;= round(x)+1/2 and x &gt;= round(x)-1/2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The round to nearest operation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/rounding1"/>
    </owl:NamedIndividual>
