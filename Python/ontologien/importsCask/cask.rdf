    <!-- http://www.openmath.org/cd/arith1#lcm -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith1#lcm">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid283"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid285"/>
        <OM-Math-Meta:commentedProperty>for all integers a,b |
There does not exist a c&gt;0 such that c/a is an Integer and c/b is an
Integer and lcm(a,b) &gt; c.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>lcm(a,b) = a*b/gcd(a,b)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol to represent the n-ary function to return the least common
