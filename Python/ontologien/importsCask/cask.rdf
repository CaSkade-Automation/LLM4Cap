        <OM-Math-Meta:description>A symbol to denote a continuous 1-dimensional interval with both end
points included in the interval. The arguments are the start and the
end points of the interval in that order.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/interval1"/>
    </owl:NamedIndividual>
