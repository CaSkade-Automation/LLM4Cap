    <!-- http://www.openmath.org/cd/complex1#conjugate -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/complex1#conjugate">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid445"/>
        <OM-Math-Meta:commentedProperty>if a is a complex number then (conjugate(a) + a) is a real number</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A unary operator representing the complex conjugate of its argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/complex1"/>
    </owl:NamedIndividual>
