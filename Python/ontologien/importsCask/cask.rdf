        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/3Dgeo2#are_on_line -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#are_on_line">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid71"/>
        <OM-Math-Meta:description>The symbol is a boolean n-ary function. Its arguments should be points. 
When applied to a sequence of points in 3-dimensional Euclidean space, its evaluated to true if and only if there is a line on which all arguments lie.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid71">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/3Dgeo2#are_on_plane -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#are_on_plane">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid73"/>
        <OM-Math-Meta:description>The symbol is a boolean n-ary function. Its arguments should be points. 
When applied to a sequence of points in 3-dimensional Euclidean space, its evaluated to true if and only if there is a plane on which all arguments lie.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid73">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
