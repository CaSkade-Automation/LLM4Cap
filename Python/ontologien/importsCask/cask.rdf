    <!-- http://www.openmath.org/cd/hypergeon0#multi_power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#multi_power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid903"/>
        <OM-Math-Meta:commentedProperty>$x^e = \prod_{i=1}^n x_i ^ {e_i}$</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>multi_power is for using the multi-index notation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
