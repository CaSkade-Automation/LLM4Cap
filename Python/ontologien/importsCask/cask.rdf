    <!-- http://www.openmath.org/cd/setname1#R -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname1#R">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2193"/>
        <OM-Math-Meta:commentedProperty>S \subset R and exists y in R : forall x in S x &lt;= y)  implies
exists z in R such that
    (( forall x in S x &lt;= z) and
     ((forall x in S x &lt;= w)  implies z &lt;= w)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of real numbers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
