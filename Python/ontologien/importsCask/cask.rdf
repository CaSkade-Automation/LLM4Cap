        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/field3#fraction_field -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/field3#fraction_field">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid592"/>
        <OM-Math-Meta:description>This is a unary function. Its argument should be a domain (as in CD ring4).
It denotes the fraction field of the domain.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/field3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid592">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
