        <OM-Math-Meta:commentedProperty>1 bel = (ln(10))/2  neper</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the dimensionless measure of one bel.
It has the short symbol form, &quot;B&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SIUsed_OffSystemUnits1"/>
