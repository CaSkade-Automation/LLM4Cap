        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents the measure of one Newton. This is the standard
SI measure for force.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/units_metric1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/units_metric1#Newton_per_sqr_metre -->

