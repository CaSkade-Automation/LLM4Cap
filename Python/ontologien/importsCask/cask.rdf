    <!-- http://www.openmath.org/cd/graph1#vertexset -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph1#vertexset">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid773"/>
        <OM-Math-Meta:description>This symbol represents the vertex set of a (directed or undirected) graph. It takes one argument, the graph.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid773">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#automorphism_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#automorphism_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid775"/>
        <OM-Math-Meta:description>This symbol is a unary function whose argument is an undirected graph. 
      When applied to an undirected graph G, it represents the automorphism
    group of  G.
The resulting automorphism group is represented as a permutation group on the
    vertices of the graph G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid775">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#is_automorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#is_automorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid777"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid779"/>
        <OM-Math-Meta:commentedProperty>If is_automorphism(M,f) then is_isomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first is a graph M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes a graph automorphism f of  M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid777">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid779">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#is_endomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#is_endomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid781"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid783"/>
        <OM-Math-Meta:commentedProperty>If is_endomorphism(M,f) then is_homomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first argument is a graph M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes that f is a graph endomorphism from M
to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid781">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid783">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#is_homomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#is_homomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid785"/>
        <OM-Math-Meta:commentedProperty>If is_homomorphism(M,N,f) then, for each pair of vertices x, y of M, we have
if {x,y} is an edge of M, then {f(x), f(y)} is an edge of N.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first and arguments are graphs M, N,
the third is a map f from the vertex set of M to the vertex set of N.
When applied to M, N, and f, it denotes that f is a graph homomorphism from M
to N.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid785">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#is_isomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#is_isomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid787"/>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first and arguments are graphs M, N,
the third is a map f from the element set of M to the element set of N.
When applied to M, N, and f, it denotes that f is a graph isomorphism from M
to N.
This means that f is a homomorphism from M to N,
that f is bijective, and that its inverse  is a homomorphism from N to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid787">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/graph2#isomorphic -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/graph2#isomorphic">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid789"/>
        <OM-Math-Meta:description>This symbol is a Boolean function with n arguments, n at least 2, which are graphs.
When applied to M_1, ..., M_n, it denotes the fact that there is an
isomorphism from each M_i to each M_j.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/graph2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid789">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#carrier -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#carrier">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid791"/>
        <OM-Math-Meta:description>This symbol represents a unary function, whose argument should be a
group G (for instance constructed by group).
When applied to G, its value should be the set of elements of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid791">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#expression -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#expression">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid793"/>
        <OM-Math-Meta:description>This symbol is a function with two arguments.  Its first
argument should be a group. The
second should be an arithmetic expression A,
whose operators are
times and power, and whose leaves are members of the carrier of G. 
When applied to
G and A, it denotes the element (of G) that is  obtained from the
leaves of A by applying the multiplication and the power map of G instead of the
times and power
from the CD arith1  appearing in A.
The symbol alg1.one occurring in A will be interpreted as 
the identity of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid793">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid795"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid797"/>
        <OM-Math-Meta:commentedProperty>A group is closed under its operation.
A groups operation is associative.
A group has an identity element.
Every element of a group has an inverse.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a constructor for groups. It takes four arguments in
the following order: a set to specify the elements in the group, a
binary operation to specify the group operation, an element to specify the
identity, and a unary operation to
specify inverses of group elements. Both the binary and unary operations should act on elements
of the set and return an element of the set.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid795">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid797">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#identity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#identity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid799"/>
        <OM-Math-Meta:description>This symbols represents a unary function, whose argument should be a
group.  It returns the identity element of the group.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid799">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#inversion -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#inversion">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid801"/>
        <OM-Math-Meta:description>This symbol represents a unary function, whose argument should be a
group G.  It returns the map sending an element of G to its inverse.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid801">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#is_commutative -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#is_commutative">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid803"/>
        <OM-Math-Meta:commentedProperty>If is_commutative(G) then for all a,b in carrier(G) a*b = b*a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The unary boolean function whose value is true iff the argument is a
commutative group.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid803">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#is_normal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#is_normal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid805"/>
        <OM-Math-Meta:commentedProperty>is_normal(G,H) implies that for all g in G and h in H then 
inverse(g)*h*g is in H.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>If G, H are the group arguments, then IsNormal(G,H) returns true precisely when
H is normal in G. That is, inverse(g)*h*g is defined and contained in H for
all h in H and g in G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid805">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#is_subgroup -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#is_subgroup">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>If is_subgroup(G,H) then H is a nonempty set of elements of G and H
is closed under multiplication and taking inverses.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The binary boolean function whose value is true iff the second
argument is a subgroup of the second.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group1#monoid -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#monoid">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid807"/>
        <OM-Math-Meta:description>This symbol is a unary function, whose argument should be a group G.
When applied to G its value is the monoid underlying G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid807">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid809"/>
        <OM-Math-Meta:description>This symbol
represents a unary function, whose argument should be a group G.  It returns
the multiplication map on G. We allow for the map to be n-ary.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid809">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#normal_closure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#normal_closure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid811"/>
        <OM-Math-Meta:commentedProperty>n in the normal closure (A,B) implies
there exists a in A and b in B s.t. n = b^(-1) a b</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The binary function whose value is the set of conjugates of 
the elements of the second group by elements of the first,
where multiplication between them is defined.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid811">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid813"/>
        <OM-Math-Meta:description>This is a symbol with three arguments.
The first argument is a group G.  Its second argument
is an element g of G and the third argument is
an integer k.
It denotes the element g^k in G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid813">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group1#subgroup -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group1#subgroup">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid815"/>
        <OM-Math-Meta:example rdf:nodeID="genid817"/>
        <OM-Math-Meta:description>This symbol is a constructor symbol with one or two arguments. The
first argument is a list or set, D, of group elements. The optional
second argument is the group G containing D. It denotes the subgroup
of G generated by D.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid815">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid817">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#conjugation -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#conjugation">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid819"/>
        <OM-Math-Meta:commentedProperty>conjugation(M,x) (y) = x * y * x^ {-1}.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a group M
and an element x of M.
When applied to M and x, it denotes conjugation on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid819">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid820"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid820">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#is_automorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#is_automorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid823"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid825"/>
        <OM-Math-Meta:commentedProperty>If is_automorphism(M,f) then is_isomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first is a group M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes a group automorphism f of  M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid823">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid825">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#is_endomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#is_endomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid827"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid829"/>
        <OM-Math-Meta:commentedProperty>If is_endomorphism(M,f) then is_homomorphism(M,M,f)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with two arguments.
The first argument is a group M,
the second is a map f from the element set of M to the element set of M.
When applied to M and f, it denotes that f is a group endomorphism from M
to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid827">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid829">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#is_homomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#is_homomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid831"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid833"/>
        <OM-Math-Meta:commentedProperty>If is_homomorphism(M,N,f) then, for each pair of elements x, y of M, we have
f(x * y) = f(x) * f(y).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first two arguments are groups M, N,
the third is a map f from the element set of M to the element set of N.
When applied to M, N, and f, it denotes that f is a group homomorphism from M
to N.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid831">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid833">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#is_isomorphism -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#is_isomorphism">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid835"/>
        <OM-Math-Meta:description>This symbol is a boolean function with three arguments.
The first and arguments are groups M, N,
the third is a map f from the element set of M to the element set of N.
When applied to M, N, and f, it denotes that f is a group isomorphism from M
to N.
This means that f is a homomorphism from M to N,
that f is bijective, and that its inverse  is a homomorphism from N to M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid835">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#isomorphic -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#isomorphic">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid837"/>
        <OM-Math-Meta:description>This symbol is a Boolean function with n arguments, n at least 2, which are groups.
When applied to M_1, ..., M_n, it denotes the fact that there is an
isomorphism from each M_i to each M_j.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid837">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#left_multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#left_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid839"/>
        <OM-Math-Meta:commentedProperty>left_multiplication(M,x) (y) = x * y.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a group M
and an element x of M.
When applied to M and x, it denotes left multiplication on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid839">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid840"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid840">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#right_inverse_multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#right_inverse_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid843"/>
        <OM-Math-Meta:commentedProperty>right_inverse_multiplication(M,x) (y) = y * x^(-1).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a group M
and an element x of M.
When applied to M and x, it denotes right multiplication on M by the inverse of x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid843">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid844"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid844">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group2#right_multiplication -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group2#right_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid847"/>
        <OM-Math-Meta:commentedProperty>right_multiplication(M,x) (y) = y * x.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a group M
and an element x of M.
When applied to M and x, it denotes right multiplication on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid847">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid848"/>
        <OM-Math:variables>
            <rdf:Description/>
        </OM-Math:variables>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid848">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#GL -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#GL">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a
vector space or a module V. When applied to 
V it represents the group of all invertible linear transformations of V.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#GLn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#GLn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with two arguments. The first should be a positive
integer n, the second a
field F. When applied to 
n and F it represents the group of all invertible linear transformations of
the vector space over F of dimension n.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#SL -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#SL">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a a
module V over a commutative ring. When applied to V it represents the
group of all invertible linear transformations of V of determinant 1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#SLn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#SLn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with two arguments. The first should
be a positive integer n, the second a field F. When applied to n and F it
represents the group of all invertible linear transformations of the vector
space over F of dimension n having determinant 1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#alternating_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#alternating_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a
set X.  When applied to a set X it represents the group of all even 
permutations on
X .</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#alternatingn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#alternatingn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be 
a natural number n.  When applied to n
it represents the group of all even permutations on the set {1,2, ...,n}.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#automorphism_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#automorphism_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a function with a single argument which must be a group.
It refers to the automorphism group of its argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#center -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#center">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid851"/>
        <OM-Math-Meta:commentedProperty>d  is in the center of G if and only if
for all g in G we have  g d= d g.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbols represents a unary function whose argument should be a group G.
Its value is the biggest subgroup of G all of whose elements
commute with all elements of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid851">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#centralizer -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#centralizer">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid853"/>
        <OM-Math-Meta:commentedProperty>d  is in the centralizer of g in G if and only if
 g d= d g.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbols represents a binary function whose first argument should be a
group G and whose second argument should be an element g or a list of elements
L of the group G.
Its value is the subgroup of G of all elements
commuting with g or, if the second argument is a list, all elements of L.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid853">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#derived_subgroup -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#derived_subgroup">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid855"/>
        <OM-Math-Meta:commentedProperty>d in the derived subgroup of G if and only if
there exist lists x,y of elements of G of equal length
 such that d
is the product x_1 y_1 x_1^(-1) y_1^(-1) ...  x_n y_n x_n^(-1) y_n^(-1).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The unary function whose value is the subgroup of argument
generated by all products of the form xyx^-1y^-1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid855">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#direct_power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#direct_power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a binary function whose first argument should be a group
G and whose second argument should be a natural number n.
It refers to the direct product of n copies of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#direct_product -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#direct_product">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is an n-ary function whose arguments must be groups.
It refers to the direct product of its arguments.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#free_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#free_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid857"/>
        <OM-Math-Meta:description>This symbol represents a unary function. The argument is a list or a
set.  When evaluated on such an argument, the function represents the
free group generated by the entries of the list or set.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid857">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#invertibles -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#invertibles">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be 
a monoid M.  When applied to M
it represents the group of all invertible elements of M.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#normalizer -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#normalizer">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid859"/>
        <OM-Math-Meta:commentedProperty>d  is in the normalizer of X in G if and only if
 g X= X g.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbols represents a binary function whose first argument should be a
group G and whose second argument should be a set of elements
or a subgroup L of the group G.
Its value is the subgroup of G of all elements
normalizing L.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid859">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group3#quotient_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#quotient_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary function whose value is the factor group of the first
argument by the second, assuming the second is normal in the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#sylow_subgroup -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#sylow_subgroup">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a binary function with two arguments,
the first is a group G and the second a prime number p.
When applied to G and p, it represents a Sylow p-subgroup of G
(which is unique up to conjugacy in G).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#symmetric_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#symmetric_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a set X.  When applied to a
set X it represents the group of all permutations on X .</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group3#symmetric_groupn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group3#symmetric_groupn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid861"/>
        <OM-Math-Meta:commentedProperty>The carrier set of symmetric_groupn(k) consists of all permutations with
support in the integers {1,...,k}.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be 
a natural number n.  When applied to n
it represents the group of all permutations on the set {1,2,... ,n}.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid861">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group4#are_conjugate -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#are_conjugate">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid863"/>
        <OM-Math-Meta:commentedProperty>x and y are conjugate if and only if there is h in G such that x = h y h^(-1).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a boolean ternary function whose first argument is a group G and
whose second and third arguments are elements x and y of G. Its value on G, x,
and y is true if and only if x and y are conjugate in G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid863">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group4#conjugacy_class -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#conjugacy_class">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid865"/>
        <OM-Math-Meta:commentedProperty>The conjugacy class in G of h is the subset {g^(-1) h g | g in G} of G.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents a binary function, whose first argument is a group G and
whose second argument is an element x of G. Its value on G and x is the set of elements which 
are conjugate to x in G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid865">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group4#conjugacy_class_representatives -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#conjugacy_class_representatives">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a unary function whose argument should be a group.
Its value on a group is a set of representatives of the conjugacy classes of
that group.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#conjugacy_classes -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#conjugacy_classes">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a unary function whose argument should be a group.
Its value on a group is the set of conjugacy classes of
that group.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#left_coset -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#left_coset">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a ternary function whose first argument is a group G,
whose second argument is a subgroup H of G, and whose third argument is an
element x of G. Its value on G, H, and x is the left coset of H in G
containing x, that is, the set x H.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#left_coset_representative -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#left_coset_representative">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a quaternary function whose first argument is a group G,
whose second argument is a subgroup H of G, whose third argument is
left_transversal T
of H in G, and whose fourth argument is an element of G.
It assigns to G, H, T, g the element of t of T representing the left coset of
H containing g, that is, t H  = g H .</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#left_cosets -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#left_cosets">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary function whose value is the set of left cosets of the second argument in the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#left_transversal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#left_transversal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary function whose value is a set of representatives for the
left cosets of the second argument as a subgroup of the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#right_coset -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#right_coset">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a ternary function whose first argument is a group G,
whose second argument is a subgroup H of G, and whose third argument is an
element x of G. Its value on G, H, and x is the right coset of H in G
containing x, that is, the set H x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#right_coset_representative -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#right_coset_representative">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol represents a quaternary function whose first argument is a group G,
whose second argument is a subgroup H of G, whose third argument is
right_transversal T
of H in G, and whose fourth argument is an element of G.
It assigns to G, H, T, g the element of t of T representing the right coset of
H containing g, that is,  H t  =  H g.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#right_cosets -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#right_cosets">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary function whose value is the set of right cosets of the second argument in the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group4#right_transversal -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group4#right_transversal">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The binary function whose value is a set of representatives for the
right cosets of the second argument as a subgroup of the first.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group4"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group5#homomorphism_by_generators -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group5#homomorphism_by_generators">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This is a function with three arguments the first two of which must be groups
F and K.
The third argument should be a set or a list L of ordered pairs (lists of length 2). Each
pair [x,y] from L consists of an element x from F and an element y from K.
When applied to F, K, and L, the symbol represents the group homomorphism from F
to K that maps the first entry x of each pair [x,y] to the second entry y of the same pair.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group5"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/group5#left_quotient_map -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group5#left_quotient_map">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid867"/>
        <OM-Math-Meta:commentedProperty>The image of an element x is the right coset of x with respect to H.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a binary function whose first argument is a group G and whose
second argument is an subgroup H of G. When applied to G and H, its value is the
natural quotient map from G to the quotient group G/H, sending x to the right
coset Hx of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group5"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid867">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/group5#right_quotient_map -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/group5#right_quotient_map">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid869"/>
        <OM-Math-Meta:commentedProperty>The image of an element x is the left coset of x with respect to H.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a binary function whose first argument is a group G and whose
second argument is an subgroup H of G. When applied to G and H, its value is the
natural quotient map from G to the quotient group G/H, sending x to the left
coset xH of G.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/group5"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid869">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/groupname1#cyclic_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/groupname1#cyclic_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be 
a natural number n.  When applied to n
it represents the cyclic group of order n.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/groupname1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/groupname1#dihedral_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/groupname1#dihedral_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid871"/>
        <OM-Math-Meta:commentedProperty>The dihedral group of order 2n is isomorphic to the group generated by
a, b with presentation a^2 = b^n = 1 and a b a = b^(-1).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a
positive integer n. When applied to n it represents the dihedral group of
order 2n. This is the group of all isometries (including reflections) of the
regular n-gon in the plane.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/groupname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid871">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/group2#isomorphic"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/groupname1#generalized_quaternion_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/groupname1#generalized_quaternion_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a
positive integer.  When applied to n it represents the generalized quaternion group
of order 4n.  This is the group with three generators a, b, and c and
relations c = a^2 = b^n, c*a = a*c , b*c = c*b, a*b = b*a*c, and c^2 = 1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/groupname1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/groupname1#quaternion_group -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/groupname1#quaternion_group">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid873"/>
        <OM-Math-Meta:commentedProperty>The center of Q has order 2.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The derived subgroup of Q coincides with the center of Q.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>The quaternion group is isomorphic to the group generated by
a, b with presentation a^2 = b^2 = aba^(-1)b^(-1) and a^4 = 1.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the quaternion group of order 8.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/groupname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid873">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/group2#isomorphic"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/hypergeo0#beta -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeo0#beta">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid875"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid877"/>
        <OM-Math-Meta:commentedProperty>beta(p,q)=\frac{gamma(p)gamma(q)}{gamma(p+q)}(p,q \not\in Z_{&lt;=0})</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>Euler&apos;s beta function</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeo0"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid875">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid877">
