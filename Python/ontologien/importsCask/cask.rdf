    <!-- http://www.openmath.org/cd/fns1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/fns1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD is intended to be `compatible&apos; with the corresponding
    elements in Content MathML.

    In this CD we give a set of functions concerning functions
    themselves. Functions can be constructed from expressions via a
    lambda expression. Also there are basic function functions like
    compose, etc.</OM-Math-Meta:description>
