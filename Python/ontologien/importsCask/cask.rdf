    <!-- http://www.openmath.org/cd/permutation1#support -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/permutation1#support">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1596"/>
        <OM-Math-Meta:description>This symbol is a function with one argument 
			                        which is a permutation.
			                        When applied to a permutation P whose
					arguments are the cycles A1,...,An, it represents
			          the set A which is the union of the entries of all Ai
                                  for i=1,...,n.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/permutation1"/>
    </owl:NamedIndividual>
