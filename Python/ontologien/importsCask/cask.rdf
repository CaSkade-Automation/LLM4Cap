        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc3#arcsinh -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arcsinh">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2441"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2443"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2445"/>
        <OM-Math-Meta:commentedProperty>Arcsinh z = ln(z +-\sqrt(1+z^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>Arcsinh(z) = - i * Arcsin(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arcsinh(x) &lt;=&gt; sinh(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the Arcsinh function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
