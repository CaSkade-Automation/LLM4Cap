    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/plangeo1#type">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1646"/>
        <OM-Math-Meta:commentedProperty>If A and B are objects of the same type, then they are not incident.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The symbol represents the type of the basic geometric objects: points,
lines, configuration.</OM-Math-Meta:description>
