    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/field2#left_multiplication">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid582"/>
        <OM-Math-Meta:commentedProperty>left_multiplication(M,x) (y) = x * y.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with two arguments, which should be a field M
and an element x of M.
When applied to M and x, it denotes left multiplication on M by x.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/field2"/>
    </owl:NamedIndividual>
