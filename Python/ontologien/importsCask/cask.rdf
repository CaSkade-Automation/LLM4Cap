    <!-- http://www.openmath.org/cd/hypergeon0#minus_part -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#minus_part">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid901"/>
        <OM-Math-Meta:commentedProperty>$u = u_{+} - u_{-}$</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The argument is a vector. It replaces positive elements in the vector 
  to zero and negative elements to their absolute values.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
