        <OM-Math-Meta:formalProperty rdf:nodeID="genid2357"/>
        <OM-Math-Meta:commentedProperty>sec A = 1/cos A</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the sec function as described in Abramowitz and
Stegun, section 4.3. It takes one argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
