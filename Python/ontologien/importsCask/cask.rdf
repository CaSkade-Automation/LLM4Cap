    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ecc#PairProj1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid504"/>
