    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/polygb">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD contains operators for Groebner basis computations with polynomial expressions.
