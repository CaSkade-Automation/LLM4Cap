    <!-- http://www.openmath.org/cd/transc3#arccsch -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arccsch">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2421"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2423"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2425"/>
        <OM-Math-Meta:commentedProperty>Arccsch z = ln(1/z +-\sqrt(1+1/z^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>Arccsch(z) = i * Arccsc(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arccsch(x) &lt;=&gt; csch(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the Arccsch function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2421">
