    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/mathmltypes#matrix_type">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1308"/>
        <OM-Math-Meta:description>A symbol to be used as the argument of the type symbol to convey the
type for a matrix (n tuple of rows, where each row is an m tuple for
some m, it should be noted that each row must be the same length).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/mathmltypes"/>
    </owl:NamedIndividual>
