    <!-- http://www.openmath.org/cd/setname3#function_set -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname3#function_set">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The function_set operator generates the set of functions
 between the sets specified as its arguments.

 cf Hom(A,B) in Category theory, and mapsto in the sts CD.

 For a set of n-argument functions, function_set will 
 take n+1 arguments, specifying the sets of the n arguments
 and the range.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname3"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/setoid#Setoid -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setoid#Setoid">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2231"/>
        <OM-Math-Meta:commentedProperty>Is defined as  
        Lambda {Carrier:&gt; symtype; Eq: 	(relation Carrier)}.
        SigmaType{ Carrier:&gt; symtype; 	
	Eq: 	(relation Carrier);	
   	(equivalence Carrier Eq) }</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The contructor for the type of set 
 with an equivalence relation on it.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setoid"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2231">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/setoid#make_Setoid -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setoid#make_Setoid">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2232"/>
        <OM-Math-Meta:commentedProperty>Is defined as  
        Lambda {Carrier:&gt; symtype; 
        Eq: 	(relation Carrier)
        proof: (equivalence Carrier Eq)}.
        Tuple (Carrier,	Eq, proof)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The contructor for the tuples consisting of a set, 
 an equivalence relation on the set, and a proof that the relation 
 is actually an equivalence relation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setoid"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2232">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/sigma#Pair -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/sigma#Pair">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>The pairing constructor. It takes two 
               OpenMath objects as first element and second 
               element of the pair, and a third optional 
               OpenMath object that represents the type of 
               this pair.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/sigma"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/sigma#PairProj1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/sigma#PairProj1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>The first projection function. It 
               satisfies sigma-reduction.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/sigma"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/sigma#PairProj2 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/sigma#PairProj2">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>The second projection function. It
               satisfies sigma-reduction.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/sigma"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/sigma#SigmaType -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/sigma#SigmaType">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:description>The type constructor of cartesian products.
