        <OM-Math-Meta:formalProperty rdf:nodeID="genid2507"/>
        <OM-Math-Meta:description>This symbol represents the measure of one Newton per square metre.
This is another (deprecated in OpenMath) name for the  standard SI measure
for pressure, the Pascal.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/units_metric1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2507">
