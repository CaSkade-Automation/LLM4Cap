        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/dimensions1#voltage -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#voltage">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:commentedProperty>voltage = current/charge</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the voltage physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/dimensions1#volume -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#volume">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid475"/>
        <OM-Math-Meta:commentedProperty>volume = length*length*length</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the volume physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid475">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/directives1#decide -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/directives1#decide">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid477"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid479"/>
        <OM-Math-Meta:commentedProperty>The response to the decide query is logically equivalent to the truth of the argument.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with one argument, which should be a clause.
When applied to a clause, it asks whether
the clause holds.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/directives1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid477">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
