    <!-- http://www.openmath.org/cd/hypergeon0#plus_part -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#plus_part">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>The argument is a vector. It replaces negative elements in the vector 
  to zero.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/hypergeon0#where -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/hypergeon0#where">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid905"/>
        <OM-Math-Meta:commentedProperty>$x^n=x x x \where{n=3}$</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>The word &quot;where&quot; is often used in mathematical expressions
  to set variables or to say side conditions.
  CDname logic1.implies can be used for these purposes, but 
  &quot;where&quot; will be more intuitive and more friendly expression
  for authors.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/hypergeon0"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid905">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
