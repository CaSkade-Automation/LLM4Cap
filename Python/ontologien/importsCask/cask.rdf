    <!-- http://www.openmath.org/cd/transc1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD holds the definitions of many transcendental
    functions. They are defined as in Abromowitz and Stegun (ninth 
    printing on), with precise reductions to logs in the case of 
    inverse functions.

    Note that, if signed zeros are supported, some strict 
    inequalities have to become weak
.
    It is intended to be `compatible&apos; with the MathML elements
    denoting trancendental functions.
    Some additional functions are in the CD transc2.</OM-Math-Meta:description>
