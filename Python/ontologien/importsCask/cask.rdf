    <!-- http://www.openmath.org/cd/3Dgeo2#circle_center -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/3Dgeo2#circle_center">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid75"/>
        <OM-Math-Meta:description>The statement that a circle in 3-dimensional Euclidean space has a given point as center. 
Takes the circle as first argument and the point as second argument.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/3Dgeo2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid75">
