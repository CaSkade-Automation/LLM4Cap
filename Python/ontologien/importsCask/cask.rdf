        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc1#arcsech -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arcsech">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2305"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2307"/>
        <OM-Math-Meta:commentedProperty>arcsech(z) = 2 ln(\sqrt((1+z)/(2z)) + \sqrt((1-z)/(2z)))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x in (0..1] | arcsech x = ln(1/x + (1/(x^2) - 1)^(1/2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arcsech function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2305">
