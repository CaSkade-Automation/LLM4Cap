        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#implies"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc1#arccsc -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arccsc">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2289"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2291"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2293"/>
        <OM-Math-Meta:commentedProperty>arccsc(-z) = - arccsc(z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>arccsc(z) = -i ln(i/z + \sqrt(1 - 1/z^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>arccsc(z) = i * arccsch(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arccsc function as described in Abramowitz
and Stegun, section 4.4.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2289">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2291">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid2293">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc1#arccsch -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc1#arccsch">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2295"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2297"/>
        <OM-Math-Meta:commentedProperty>arccsch(z) = i * arccsc(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>arccsch(z) = ln(1/z + \sqrt(1+(1/z)^2))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the arccsch function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc1"/>
    </owl:NamedIndividual>
