    <!-- http://www.openmath.org/cd/SI_BaseQuantities#amount-of-substance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#amount-of-substance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of amount of substance.
      It has the short symbol form, &quot;N&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#current -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#current">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of electrical current.
      It has the short symbol form, &quot;I&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#length -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#length">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of length.
      It has the short symbol form, &quot;L&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#luminous-intensity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#luminous-intensity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of luminous intensity.
      It has the short symbol form, &quot;J&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#mass -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#mass">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of mass.
      It has the short symbol form, &quot;M&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#one -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#one">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the proposed SI base quantity of dimension one,
      or the dimensionless quantity.
      It has the short symbol form, &quot;1&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#temperature -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#temperature">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of thermodynamic temperature.
      It has the short symbol form, &quot;\Theta;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseQuantities#time -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseQuantities#time">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>This symbol represents the SI base quantity of time.
      It has the short symbol form, &quot;T&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseQuantities"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#ampere -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#ampere">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid139"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as that constant electric current which, if
    maintained in two parallel conductors of infinite length, of
    negligible circular cross-section, and placed 1 metre apart in vacuum,
    would produce between these conductors a force equal to
    2 × 10–7 newton per metre of length [9th CGPM (1948)].</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>ampere = unit(current)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one ampere, the standard
      SI unit of measure for quantities of electric current.
      It has the short symbol form, &quot;A&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid139">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#candela -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#candela">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid141"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as the luminous intensity, in a given
    direction, of a source that emits monochromatic radiation of frequency
    540×10^12 hertz and that has a radiant intensity in that direction of
    1/683 watt per steradian [16th CGPM (1979)].</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>candela = unit(luminous intensity)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one candela, the standard
      SI unit measure for quantities of luminous intensity.
      It has the short symbol form, &quot;cd&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid141">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#kelvin -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#kelvin">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid143"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as equal to the fraction 1/273.16 of the
    thermodynamic temperature of the triple point of water
    [International Temperature Scale of 1990, ITS-90, adopted by CIPM in 1989].
    The isotopic composition of the water is defined by Vienna Standard
    Mean Ocean Water.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>kelvin = unit(temperature)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one kelvin, the standard
      SI unit of measure for quantities of thermodynamic temperature.
      It has the short symbol form, &quot;K&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid143">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#kilogram -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#kilogram">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid145"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as the mass of the International Prototype
    Kilogram stored at the International Bureau of Weights and Measures
    (BIPM) in in Sèvres, France [3rd CGPM (1901)]. A proposal is pending
    to redefine the standard mass in terms of natural constants.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>kilogram = unit(mass)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one kilogram of mass, the standard
      SI unit of measure for quantities of mass.
      It has the short symbol form, &quot;kg&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid145">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#metre -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#metre">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid147"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as the length of the path travelled by light
    in vacuum during a time interval of 1/299 792 458 of a second.
    This definition was provided in 1983 by the seventeenth General
    Conference on Weights and Measures (CGPM) [17th CGPM (1983)].</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>metre = unit(length)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one metre of length, the standard
      SI unit of measure for quantities of length or physical distance.
      It has the short symbol form, &quot;m&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid147">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#mole -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#mole">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid149"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as the amount of substance of a system which
    contains as many &quot;elemental entities&quot; as there are atoms in 12 grams
    of carbon-12 [14th CGPM (1971)].</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>mole = unit(amount of substance)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one mole, the standard
      SI unit measure for quantities of amount of substance.
      It has the short symbol form, &quot;mol&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid149">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#one -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#one">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid151"/>
        <OM-Math-Meta:commentedProperty>one = unit(one) = 1</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the dimensionless unit corresponding to the
      dimensionless quantity dimension.
      It has the short symbol form, &quot;1&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid151">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_BaseUnits1#second -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_BaseUnits1#second">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid153"/>
        <OM-Math-Meta:commentedProperty>This is a base unit for the SI system.
    It is defined physically as the duration of 9,192,631,770 periods of
    the radiation corresponding to the transition between the two
    hyperfine levels of the ground state of the caesium 133 atom
    [13th CGPM (1967)].
    This definition refers to a caesium atom at rest at a temperature of 0
    kelvin (absolute zero). The ground state is defined at zero magnetic
    field [1997 meeting of the BIPM].</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>second = unit(time)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the measure of one second of time, the standard
      SI unit of measure for quantities of time.
      It has the short symbol form, &quot;s&quot;, in upright roman font.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_BaseUnits1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid153">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#angle -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#angle">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid155"/>
        <OM-Math-Meta:commentedProperty>dim(angle) = one</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the quantity of a geometric planar angle.
      A variable representing an arbitrary quantity of angle
      is commonly represented with the
      italic, lower case greek variable, e.g., &quot;\theta;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid155">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#area -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#area">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid157"/>
        <OM-Math-Meta:commentedProperty>dim(area) = length*length</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of area.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid157">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#capacitance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#capacitance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid159"/>
        <OM-Math-Meta:commentedProperty>dim(capacitance) = dim(charge/voltage) = current^2*time^4/(mass*length^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of electric capacitance.
A variable representing an arbitrary quantity of capacitance 
is commonly represented with the
italic, upper case letter, &quot;C&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid159">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#charge -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#charge">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid161"/>
        <OM-Math-Meta:commentedProperty>dim(charge) = current*time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of electric charge.
A variable representing an arbitrary quantity of charge 
is commonly represented with the
italic, upper case letter, &quot;Q&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid161">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#concentration -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#concentration">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid163"/>
        <OM-Math-Meta:commentedProperty>dim(concentration) = (amount of substance)/length^3</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of concentration, the
    amount of a substance in a volume.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid163">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#conductance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#conductance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid165"/>
        <OM-Math-Meta:commentedProperty>dim(conductance) = dim(current/voltage) = current^2*time^3/(mass*length^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of electrical conductance,
the inverse of resistance.
A variable representing an arbitrary quantity of conductance 
is commonly represented with the
italic, upper case letter, &quot;G&quot; or &quot;S&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid165">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#density -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#density">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid167"/>
        <OM-Math-Meta:commentedProperty>dim(density) = mass/(length^3)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of volumic mass density.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid167">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#energy -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#energy">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid169"/>
        <OM-Math-Meta:commentedProperty>dim(energy) = dim(force)*length = mass*length^2/(time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of energy.
A variable representing an arbitrary quantity of energy 
is commonly represented with the
italic, upper case letter, &quot;E&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid169">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#entropy -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#entropy">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid171"/>
        <OM-Math-Meta:commentedProperty>dim(entropy) = dim(energy/temperature)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of entropy, a measure
    of the disorder of a system.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid171">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#force -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#force">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid173"/>
        <OM-Math-Meta:commentedProperty>dim(force) = mass*length/(time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of force. 
A variable representing an arbitrary quantity of force 
is commonly represented with the
italic, upper case letter, &quot;F&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid173">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#frequency -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#frequency">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid175"/>
        <OM-Math-Meta:commentedProperty>dim(frequency) = one/time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of frequency.
A variable representing an arbitrary quantity of frequency
is commonly represented with the
italic, lower case greek variable, &quot;\omega;&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid175">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#heat -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#heat">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid177"/>
        <OM-Math-Meta:commentedProperty>dim(heat) = dim(energy) = mass*length^2/(time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of energy that is transferred
    from one object to another due to a difference in temperature.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid177">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#illuminance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#illuminance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid179"/>
        <OM-Math-Meta:commentedProperty>dim(illuminance) = dim(luminous flux)/(length^2)
      = (luminous intensity)/(length^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of illuminance.
A variable representing an arbitrary quantity of illuminance 
is commonly represented with the
italic, upper case letter, &quot;E&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid179">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#inductance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#inductance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid181"/>
        <OM-Math-Meta:commentedProperty>dim(inductance) = dim(voltage)*time/current =  mass*length^2/(current^2*time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of electrical inductance.
A variable representing an arbitrary quantity of inductance 
is commonly represented with the
italic, upper case letter, &quot;L&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid181">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#momentum -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#momentum">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid183"/>
        <OM-Math-Meta:commentedProperty>dim(momentum) = mass*length/time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of momentum.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid183">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#power -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#power">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid185"/>
        <OM-Math-Meta:commentedProperty>dim(power) = dim(energy)/time = mass*length^2/(time^3)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of power, or energy
divided by time.
A variable representing an arbitrary quantity of power 
is commonly represented with the
italic, upper case letter, &quot;P&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid185">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#pressure -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#pressure">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid187"/>
        <OM-Math-Meta:commentedProperty>dim(pressure) = dim(force)/dim(area) = mass/(length*time*time)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of pressure.
A variable representing an arbitrary quantity of pressure 
is commonly represented with
the italic, lower case letter, &quot;p&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid187">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#radioactivity -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#radioactivity">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid189"/>
        <OM-Math-Meta:commentedProperty>dim(radioactivity) = dim(1/time)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of radio nuclide activity,
or radioactivity.
A variable representing an arbitrary quantity of radioactivity 
is commonly represented with the
italic, upper case letter, &quot;A&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid189">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#resistance -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#resistance">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid191"/>
        <OM-Math-Meta:commentedProperty>dim(resistance) = dim(voltage/current) = mass*length^2/(current^2*time^3)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of electrical resistance,
the resistance that an electrical circuit has to electrical current.
A variable representing an arbitrary quantity of electrical resistance 
is commonly represented
with the italic, upper case letter, &quot;R&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid191">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#speed -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#speed">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid193"/>
        <OM-Math-Meta:commentedProperty>dim(speed) = length/time</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of speed. It is the size of the
    derivative of position with respect to time.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid193">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#voltage -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#voltage">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid195"/>
        <OM-Math-Meta:commentedProperty>dim(voltage) = dim(energy/charge) = mass*length^2/(current*time^3)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of voltage or electric tension.
A variable representing an arbitrary quantity of voltage 
is commonly represented with the
italic, upper case letter, &quot;V&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid195">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation4#eqs"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/SI_DerivedQuantities1#volume -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SI_DerivedQuantities1#volume">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid197"/>
        <OM-Math-Meta:commentedProperty>dim(volume) = length^3</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the physical quantity of volume.
      It has the short symbol form, &quot;V&quot;.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/SI_DerivedQuantities1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid197">
