        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/transc3#arctanh -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arctanh">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2451"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2453"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2455"/>
        <OM-Math-Meta:commentedProperty>Arctanh(z) = - i * Arctan(i * z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all x arctanh(x) = 1/2 * ln((1 + x)/(1 - x))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arctanh(x) &lt;=&gt; tanh(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the Arctanh function as described in Abramowitz
and Stegun, section 4.6.</OM-Math-Meta:description>
        <rdfs:comment>The condition 0\le x^2 &lt; 1 in A+S is not necessary
  The proof for Arctan is in JHD&apos;s OpenMath deliverable</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2451">
