    <!-- http://www.openmath.org/cd/dimensions1#acceleration -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/dimensions1#acceleration">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid455"/>
        <OM-Math-Meta:commentedProperty>acceleration = length/(time^2)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the acceleration physical dimension. It is the
second derivative of distance with respect to time.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
    </owl:NamedIndividual>
