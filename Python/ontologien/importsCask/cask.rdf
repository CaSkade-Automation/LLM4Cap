        <OM-Math-Meta:formalProperty rdf:nodeID="genid463"/>
        <OM-Math-Meta:commentedProperty>force = mass*length/time^2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the force physical dimension.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/dimensions1"/>
