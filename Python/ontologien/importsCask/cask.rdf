    <!-- http://www.openmath.org/cd/setname2#H -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#H">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2213"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2215"/>
        <OM-Math-Meta:commentedProperty>1 is a quaternion and
there exists i,j,k s.t. i,j,k are quaternions and
i^2 = j^2 = k^2 = ijk = -1 with abs(i) not = abs(j) not = abs(k) not = 1
implies for all q, q a quaternion implies there exists r_0, r_1, r_2,
r_3 reals s.t. 
            q = r_0 + r_1*i + r_2*j + r_3*k</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This  symbol represents the set of quaternions.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2213">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
