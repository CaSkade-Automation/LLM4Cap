        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/numerical1#relative_error_bound -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/numerical1#relative_error_bound">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol marks an estimated upper bound for the relative error
	   ( |true-computed|/|computed| ) on a computation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/numerical1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/numerical1#relative_error_requested -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/numerical1#relative_error_requested">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol marks a requirement for the relative error
	   ( |true-computed|/|computed| ) on a computation.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/numerical1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/numerical2#discrimination_criteria -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/numerical2#discrimination_criteria">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1438"/>
        <OM-Math-Meta:description>This symbol is used to describe the minimum distance between two
         distinct objects, i.e. if the distance is less than this they are
         considered to be the same.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/numerical2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1438">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/numerical2#initial_value -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/numerical2#initial_value">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:description>This symbol marks an initial value for a parameter, for example
         this could be the point from which a newton iteration would start.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/numerical2"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/nums1#NaN -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#NaN">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1440"/>
        <OM-Math-Meta:commentedProperty>NaN is not equal to NaN</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A symbol to convey the notion of not-a-number.
The result of an ill-posed floating computation.
See IEEE standard for floating point representations.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1440">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#neq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/nums1#based_float -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#based_float">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1442"/>
        <OM-Math-Meta:description>This symbol represents the constructor function for floating point numbers,
specifying the base. It takes two arguments, the first is a positive 
integer to denote the base to which the number is represented, the
second argument is a string which contains an optional sign and the
digits of the number, using 0-9a-z and optionally a &quot;.&quot; 
(as a consequence of this no radix greater than 36 is supported).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1442">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/nums1#based_integer -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#based_integer">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1444"/>
        <OM-Math-Meta:description>This symbol represents the constructor function for integers,
specifying the base. It takes two arguments, the first is a positive 
integer to denote the base to which the number is represented, the
second argument is a string which contains an optional sign and the
digits of the integer, using 0-9a-z (as a consequence of this no radix
greater than 36 is supported). Base 16 and base 10 are already
covered in the encodings of integers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1444">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/nums1#e -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#e">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1446"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1448"/>
        <OM-Math-Meta:commentedProperty>e = the sum as j ranges  from 0 to infinity of 1/(j!)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the base of the natural logarithm, approximately 2.718.
See Abramowitz and Stegun, Handbook of Mathematical Functions,
section 4.1.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1446">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1448">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/nums1#gamma -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/nums1#gamma">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1450"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1452"/>
        <OM-Math-Meta:commentedProperty>gamma = limit_(m -&gt; infinity)(sum_(j ranges from 1 to m)(1/j) - ln m)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A symbol to convey the notion of the gamma constant
as defined in Abramowitz and Stegun, Handbook of Mathematical
Functions, section 6.1.3. It is the limit of
1 + 1/2 + 1/3 + ... + 1/m - ln m
as m tends to infinity, this is approximately 0.5772 15664.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/nums1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1450">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid1452">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


