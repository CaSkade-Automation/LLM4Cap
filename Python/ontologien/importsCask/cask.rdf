    <!-- http://www.openmath.org/cd/setname1#N -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname1#N">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2177"/>
        <OM-Math-Meta:commentedProperty>for all n | n in the natural numbers is equivalent to saying 
n=0 or n-1 is a natural number</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the set of natural numbers (including zero).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2177">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
