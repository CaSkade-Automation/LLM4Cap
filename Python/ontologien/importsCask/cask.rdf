    <!-- http://www.openmath.org/cd/calculus1#diff -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/calculus1#diff">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid369"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid371"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid373"/>
        <OM-Math-Meta:commentedProperty>diff(lambda y:a(y) * b(y))(x) = diff(lambda y:a(y))(x) * b(x) + 
                                a(x) * diff(lambda y:b(y))(x)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>diff(lambda y:a(y) + b(y))(x) = diff(lambda y:a(y))(x) + diff(lambda y:b(y))(x)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to express ordinary differentiation of a unary
function. The single argument is the unary function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/calculus1"/>
    </owl:NamedIndividual>
