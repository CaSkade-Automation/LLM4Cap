        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/permutation1#sign -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/permutation1#sign">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1590"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1592"/>
        <OM-Math-Meta:commentedProperty>If the cycle type of a permutation P equals [a_1,...,a_m],
then the sign is equal to (-1)^(s-m) where b = a_1+...+a_m.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is a function with one argument which should be a
permutation.
When applied to a permutation P, it represents the sign of P,
which is equal to -1 if P is an odd permutation and
equal to 1 otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/permutation1"/>
    </owl:NamedIndividual>
