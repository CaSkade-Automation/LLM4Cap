    <!-- http://www.openmath.org/cd/relation1#leq -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/relation1#leq">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1882"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1884"/>
        <OM-Math-Meta:commentedProperty>a&lt;=b and b&lt;=c implies a&lt;=c</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the binary less than or equal to function which returns
true if the first argument is less than or equal to the second, it
returns false otherwise.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/relation1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1882">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
