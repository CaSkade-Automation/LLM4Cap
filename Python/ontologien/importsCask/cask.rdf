    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/mathmltypes#fn_type">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1302"/>
