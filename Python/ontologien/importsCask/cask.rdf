        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/weylalgebra1#act_of_poly -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/weylalgebra1#act_of_poly">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2587"/>
        <OM-Math-Meta:commentedProperty>$  x^{m} \partial_{x}^{n} \partial_{y}^{r} \cdot f 
   = x^{m} \frac{partial^{n+r} f}{\partial x^{n} \partial y^{r}}
  $</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>action of a polynomial as a differential operator to a function.
  act_of_poly is equivalent to  the composition of act and diffop.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/weylalgebra1"/>
    </owl:NamedIndividual>
