        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/logic1#equivalent"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/setname1#Q -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname1#Q">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2185"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2189"/>
        <OM-Math-Meta:commentedProperty>for all a,b | a,b rational with a&lt;b implies there exists rational a,c
  s.t. a&lt;c and c&lt;b</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all z where z is a rational, there exists integers p and q with
q &gt; 1 and p/q = z</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This  symbol represents the set of rational numbers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname1"/>
    </owl:NamedIndividual>
