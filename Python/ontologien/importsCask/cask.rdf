    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/polysts#polynomial_ring">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:description>The type of all polynomial rings, e.g. from polyr or polyd OCDs</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/polysts"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/polyu#poly_u_rep -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/polyu#poly_u_rep">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1828"/>
        <OM-Math-Meta:description>A constructor for the representation of polynomials.
         The first argument is the polynomial variable, the rest are
         monomials (in decreasing order of exponent).</OM-Math-Meta:description>
