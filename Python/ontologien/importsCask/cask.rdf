        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/setname2#GFpn -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#GFpn">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2211"/>
        <OM-Math-Meta:description>This symbol represents the finite field with p^n elements, where p is a prime.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2211">
