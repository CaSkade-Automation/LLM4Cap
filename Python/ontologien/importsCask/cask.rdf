    <!-- http://www.openmath.org/cd/physical_consts1#Avogadros_constant -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#Avogadros_constant">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1598"/>
        <OM-Math-Meta:commentedProperty>Avogadros constant is 6.0221367*10^(23) +/- 3.6*10^(17).</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the number of atoms in 12 grammes of pure
carbon(12). It is approximately 6.0221367*10^(23) +/- 3.6*10^(17).</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
