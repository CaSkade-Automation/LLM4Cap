    <!-- http://www.openmath.org/cd/transc3#arccot -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/transc3#arccot">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2405"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2407"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2409"/>
        <OM-Math-Meta:commentedProperty>arccot(-z) = - arccot(z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>arccot(z) = (i/2)ln((1+iz)/(1-iz)),
so the multi-valued equivalent is
Arccot(z) = (i/2)Ln((1+iz)/(1-iz)),</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>y in Arccot(x) &lt;=&gt; cot(y)=x</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the multi-valued arccot function as the inverse of cot</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/transc3"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2405">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
