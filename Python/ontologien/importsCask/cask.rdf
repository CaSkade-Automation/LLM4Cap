    <!-- http://www.openmath.org/cd/arith2#inverse -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/arith2#inverse">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid329"/>
        <OM-Math-Meta:commentedProperty>inverse(inverse(a))=a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>A unary operator which represents the inverse of an element of a set. This
symbol could be used to represent additive or multiplicative inverses.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/arith2"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid329">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Binding"/>
        <OM-Math:binder rdf:resource="http://www.openmath.org/cd/quant1#forall"/>
        <OM-Math:body rdf:nodeID="genid330"/>
        <OM-Math:variables>
