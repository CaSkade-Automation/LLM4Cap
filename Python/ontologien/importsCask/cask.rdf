    <!-- http://www.openmath.org/cd/physical_consts1#Loschmidt_constant -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/physical_consts1#Loschmidt_constant">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ConstantSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid1608"/>
        <OM-Math-Meta:commentedProperty>The Loschmidt constant is 2.686763 * 10^(25) +/- 2.3 *
10^(20) per metre cubed.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the number of particles per unit volume of an
ideal gas at standard temperature and pressure. It is approximately
2.686763 * 10^(25) +/- 2.3 * 10^(20) per metre cubed.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/physical_consts1"/>
    </owl:NamedIndividual>
