        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/meta#Example"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/polyoperators1#gcd -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/polyoperators1#gcd">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid1812"/>
        <OM-Math-Meta:description>The n-ary greatest common divisor for univariate polynomials.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/polyoperators1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid1812">
