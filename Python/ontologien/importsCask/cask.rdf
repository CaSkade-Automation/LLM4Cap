        <OM-Math-Meta:formalProperty rdf:nodeID="genid600"/>
        <OM-Math-Meta:commentedProperty>The field of complex numbers is (C, +,0,-,*,1,/), where +,-,*,/ are the standard
arithmetic operations.</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This is a symbol representing the field of complex numbers.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/fieldname1"/>
    </owl:NamedIndividual>
