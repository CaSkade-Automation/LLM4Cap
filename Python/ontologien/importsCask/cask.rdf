        <OM-Math-Meta:description>The binder symbol used to construct the
  	type of Cartesian products.  The (either plain or attributed)
  	variables might occur in the body \OM\ object.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/ecc"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/ecc#Tuple -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/ecc#Tuple">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid508"/>
