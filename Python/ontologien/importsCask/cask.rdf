    <!-- http://www.openmath.org/cd/SIUsed_OffSystemMeasuredUnits1 -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/SIUsed_OffSystemMeasuredUnits1">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#Library"/>
        <OM-Math-Meta:description>This CD defines symbols to represent units that are off-system
