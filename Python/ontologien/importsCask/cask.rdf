        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/polyslp#poly_ring_SLP"/>
    </rdf:Description>
    <rdf:Description>
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Literal"/>
        <OM-Math:value>The polynomial x^2 + y^2,
    which may be represented as the Straight Line Program :

        line 1 : InputNode	x
        line 2 : InputNode	y
        line 3 : OperationNode 	times line 1, line 1
        line 4 : OperationNode 	times line 2, line 2
        line 5 : OperationNode 	plus line 3, line 4 &gt;

    may be encoded as :</OM-Math:value>
    </rdf:Description>
    <rdf:Description rdf:nodeID="genid6933">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
