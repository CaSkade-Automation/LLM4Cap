    <!-- http://www.openmath.org/cd/setname2#QuotientField -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/setname2#QuotientField">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Symbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid2217"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2219"/>
        <OM-Math-Meta:commentedProperty>R is a field iff QuotientField(R)=R</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol represents the quotient field of any integral domain.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/setname2"/>
    </owl:NamedIndividual>
