    <!-- http://www.openmath.org/cd/veccalc1#Laplacian -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/veccalc1#Laplacian">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>laplacian(F) = \partial^2(F)/\partial(x_1)^2 + ... +
\partial^2(F)/\partial(x_n)^2</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent the laplacian function. It takes one
argument which should be a vector of scalar valued functions, intended
to represent a vector valued function and returns a vector of
functions. It should satisfy the defining relation:
laplacian(F) = \partial^2(F)/\partial(x_1)^2 + ... +
\partial^2(F)/\partial(x_n)^2</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/veccalc1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/veccalc1#curl -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/veccalc1#curl">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid2583"/>
        <OM-Math-Meta:commentedProperty>curl(F) = i X \partial(F)/\partial(x) + j X \partial(F)/\partial(y) +
j X \partial(F)/\partial(Z)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent the curl function. It takes one
argument which should be a vector of scalar valued functions, intended
to represent a vector valued function and returns a vector of
functions. It should satisfy the defining relation:
curl(F) = i X \partial(F)/\partial(x) + j X \partial(F)/\partial(y) +
j X \partial(F)/\partial(Z) where i,j,k are the unit vectors
corresponding to the x,y,z axes respectively and the multiplication X
is cross multiplication.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/veccalc1"/>
    </owl:NamedIndividual>
    <rdf:Description rdf:nodeID="genid2583">
        <rdf:type rdf:resource="http://openmath.org/vocab/math#Application"/>
        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/veccalc1#divergence -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/veccalc1#divergence">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>divergence(F) = \partial(F_(x_1))/\partial(x_1) + ...
 + \partial(F_(x_n))/\partial(x_n)</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent the divergence function. It takes one
argument which should be a vector of scalar valued functions,
intended to represent a vector valued function and returns a
scalar value. It should satisfy the defining relation:
 divergence(F) = \partial(F_(x_1))/\partial(x_1) + ...
 + \partial(F_(x_n))/\partial(x_n)</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/veccalc1"/>
    </owl:NamedIndividual>
    


    <!-- http://www.openmath.org/cd/veccalc1#grad -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/veccalc1#grad">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:commentedProperty>grad(F) = (\partial(F)/\partial(x_1), ... ,\partial(F)/partial(x_n))</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent the grad function. It takes one
argument which should be a scalar valued function and returns a
vector of functions. It should satisfy the defining relation:
grad(F) = (\partial(F)/\partial(x_1), ... ,\partial(F)/partial(x_n))</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/veccalc1"/>
    </owl:NamedIndividual>
    


