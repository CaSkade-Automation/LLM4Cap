        <OM-Math:arguments>
            <rdf:Description/>
        </OM-Math:arguments>
        <OM-Math:operator rdf:resource="http://www.openmath.org/cd/relation1#eq"/>
    </rdf:Description>
    


    <!-- http://www.openmath.org/cd/calculus1#defint -->

    <owl:NamedIndividual rdf:about="http://www.openmath.org/cd/calculus1#defint">
        <rdf:type rdf:resource="http://openmath.org/vocab/math/meta#ApplicationSymbol"/>
        <OM-Math-Meta:example rdf:nodeID="genid357"/>
        <OM-Math-Meta:example rdf:nodeID="genid359"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid361"/>
        <OM-Math-Meta:formalProperty rdf:nodeID="genid365"/>
        <OM-Math-Meta:commentedProperty>for all a &lt; b &lt; c | integral over [a,c] = integral over [a,b] + 
integral over [b,c]</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:commentedProperty>for all a,b | integral from a to b = -integral from b to a</OM-Math-Meta:commentedProperty>
        <OM-Math-Meta:description>This symbol is used to represent definite integration of unary
functions. It takes two arguments; the first being the range (e.g. a
set) of integration, and the second the function.</OM-Math-Meta:description>
        <rdfs:isDefinedBy rdf:resource="http://www.openmath.org/cd/calculus1"/>
    </owl:NamedIndividual>
